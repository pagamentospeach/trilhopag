enum WithdrawalStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELED
  REJECTED
}

/**
 * Destinos salvos pra saque — chave PIX OU carteira USDT.
 * Usuário cadastra uma vez e usa em saques futuros sem precisar redigitar.
 * Tipo "pix": pixKey + pixKeyType.
 * Tipo "usdt_solana": walletAddress.
 */
model PayoutDestination {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("UserPayoutDestinations", fields: [userId], references: [id], onDelete: Cascade)
  /// "pix" | "usdt_solana"
  type          String
  /// Apelido pro user identificar (ex: "Minha Caixa", "Wallet principal")
  label         String
  /// Pix only — chave
  pixKey        String?
  pixKeyType    String?
  /// USDT only — endereço Solana
  walletAddress String?
  /// É o destino padrão pra esse tipo? (auto-selecionado no form)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([userId, type])
}

model Withdrawal {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents     Int
  feeCents        Int              @default(0)
  /**
   * Método do saque: "pix" (default) ou "usdt_solana".
   * USDT P2P custa 1% (sem taxa fixa) com mínimo R$ 2.000 (davi 23/07/2026).
   * Pago manualmente pelo admin via DEX/exchange depois de receber notificação.
   */
  method          String           @default("pix")
  /**
   * Pra PIX: chave Pix. Pra USDT: ignorado (usar walletAddress).
   */
  pixKey          String
  pixKeyType      String
  /**
   * Endereço da carteira Solana (só pra USDT P2P).
   */
  walletAddress   String?
  status          WithdrawalStatus @default(PENDING)
  failReason      String?
  paidAt          DateTime?
  /// ID da transferência na SafePix (saque AUTOMÁTICO). Pra correlação com o
  /// webhook safepix-transfer + auditoria. Null em saques manuais.
  providerId      String?
  /// Conta SafePix usada no saque automático (ex: "safepix-3"). Auditoria.
  providerAccount String?
  /**
   * Relatorio de auditoria computado no momento da solicitacao.
   * Shape: { flags: [{code, severity, message}], score: 0-100,
   * balanceMatch: {...}, ratios: {refund, chargeback}, ... }
   * Severity "block" bloqueia a criacao do saque automaticamente.
   * Admin ve os flags na tela de saques antes de aprovar.
   */
  auditReport     Json?
  /**
   * Score 0-100 calculado pela auditoria (0=clean, 100=critical).
   */
  auditScore      Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@index([method])
  @@index([auditScore])
}

model UserSettings {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 08/08/2026 (davi): "Deixa o tema white padrao quando alguem cria a conta
