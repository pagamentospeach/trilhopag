  /// Dedup do resumo diário por push (guarda "YYYY-MM-DD" do último envio).
  lastDailySummaryDay     String?
  /// Dedup do alerta "vendas sem campanha" (UTM faltando) — "YYYY-MM-DD".
  lastUtmAlertDay         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

