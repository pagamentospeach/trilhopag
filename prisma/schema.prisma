  /// Customização da sidebar (ordem por grupo + labels custom). Shape:
  /// { order: { [groupKey]: string[] }, labels: { [identifier]: string } }
  sidebarConfig    Json    @default("{}")
  /// Idioma da UI — código BCP47 (ex: "pt-BR", "en-US", "es-ES")
  locale           String  @default("pt-BR")

  /// ===== Tracking / ROAS (media buyer) =====
  /// Meta de ROAS padrão (global). 0 = sem meta. Usado pra pintar as linhas
