// ----------- Trilho business models -----------

enum ProductType {
  DIGITAL
  PHYSICAL
  SUBSCRIPTION
  SERVICE
}

model ProductFolder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserProductFolders", fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#84CC16")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([userId])
}

model Product {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Pasta opcional pra organização
  folderId  String?
  folder    ProductFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  /// Ordem manual dentro da pasta/lista
  sortOrder Int            @default(0)

  name        String
  description String?
  image       String?
  type        ProductType @default(DIGITAL)

  priceCents Int
  currency   String @default("BRL")
  slug       String @unique

  active Boolean @default(true)

  /// REJEIÇÃO PELO ADMIN (anti-fraude). Quando true, TODOS os checkouts deste
  /// produto saem do ar na hora (/c/[slug] → 404) e o seller vê um aviso na
  /// dashboard. Independente de `active` (que o seller controla).
  adminRejected     Boolean   @default(false)
  adminRejectReason String?
  adminRejectedAt   DateTime?

  intervalDays Int?

  sacEmail    String?
  sacWhatsapp String?
  pageUrl     String?

  recoveryEnabled         Boolean @default(false)
  recoveryDiscount15Cents Int?
  recoveryDiscount30Cents Int?
  recoveryRedirectUrl     String?

  /// Disparo (SMS/Email) — config POR PRODUTO. O envio usa os provedores
  /// PRÓPRIOS do seller (DispatchProvider), não os nossos. Templates aceitam
  /// variáveis: {nome} {produto} {valor} {link}.
  dispatchEmailEnabled Boolean @default(false)
  dispatchSmsEnabled   Boolean @default(false)
  dispatchEmailSubject String?
  dispatchEmailBody    String?
  dispatchSmsBody      String?
  /// CSV de minutos pós-PIX pendente pra disparar (ex: "5,15,30").
  dispatchDelays       String  @default("5,15,30")

  /// Cobrança RECORRENTE — opcional. Se habilitada, cada venda inicial
  /// cria uma Subscription que será re-cobrada automaticamente pelo
  /// cron em intervalos definidos pelo `recurrenceInterval`.
  recurrenceEnabled     Boolean @default(false)
  /// "weekly" | "monthly" | "quarterly" | "yearly"
  recurrenceInterval    String?
  /// Dias de trial GRATUITO antes da primeira cobrança recorrente
  /// (a venda inicial cobra normal — o trial conta do dia da venda
  /// pra próxima cobrança).
  recurrenceTrialDays   Int?
  /// Quantas vezes cobrar até cancelar a subscription (null = infinita).
  /// Útil pra "cobrança parcelada" de coisas finitas (12x mensal de um
  /// curso, por exemplo).
  recurrenceMaxBillings Int?

  /// OVERRIDE de adquirente PIX por produto. Quando habilitado, as
  /// transações desse produto usam APENAS a adquirente listada aqui,
  /// ignorando a ordem global do user em UserAcquirer.
  /// Quando false ou acquirerOverrideId nulo, cai no fallback padrão.
  acquirerOverrideEnabled Boolean   @default(false)
  acquirerOverrideId      String?
  acquirerOverride        Acquirer? @relation("ProductAcquirerOverride", fields: [acquirerOverrideId], references: [id], onDelete: SetNull)

  checkouts      Checkout[]
  transactions   Transaction[]
  coproducers    Coproducer[]
  deliverable    Deliverable?
  trackingPixels TrackingPixel[]
  memberAccess   MemberAreaProduct[]
  subscriptions  Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([active])
  @@index([folderId])
}

model Coproducer {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  email        String
  name         String?
  splitPercent Float
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId])
}

model Deliverable {
  id           String   @id @default(cuid())
  productId    String   @unique
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// "url" | "text" | "memberArea"
  kind         String   @default("url")
  contentUrl   String?
  contentText  String?
  /// Quando kind="memberArea": qual área de membros liberar
  memberAreaId String?
  emailSubject String?
  emailBody    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Checkout {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  slug              String               @unique
  active            Boolean              @default(true)
  /// REJEIÇÃO PELO ADMIN (anti-fraude). Quando true, este checkout sai do ar
  /// na hora (/c/[slug] → 404) e o seller vê um aviso na dashboard.
  adminRejected     Boolean              @default(false)
  adminRejectReason String?
  adminRejectedAt   DateTime?
  /// Domínio PRÓPRIO do seller — quando setado, checkout serve neste
  /// domínio (DNS apontado pelo seller, prova de posse necessária).
  customDomain      String?
  /// Domínio do POOL da plataforma — admin cadastra vários dominios em
  /// AdminCheckoutDomain e o seller escolhe um. Resolution priority:
  /// poolDomain (FK) > customDomain (próprio) > primeiro pool ativo.
  poolDomainId      String?
  poolDomain        AdminCheckoutDomain? @relation(fields: [poolDomainId], references: [id], onDelete: SetNull)

  /// Tipo de checkout (define qual builder + UI a usar):
  /// "standard" — tradicional, 1 step
  /// "vsl"      — VSL com vídeo grande e CTA atrasado
  /// "mobile"   — otimizado pra celular (cards full-width)
  /// "express"  — botão único, 1 clique
  /// "social"   — com prova social, depoimentos, urgência
  checkoutType String @default("standard")

  /// Preço deste checkout específico — se null, usa o do Product.
  /// Cada checkout pode ter seu próprio preço (diferentes campanhas, ofertas).
  priceCentsOverride Int?

  theme          Json     @default("{}")
  paymentMethods String[] @default(["pix"])

  /// Onde alocar os order bumps visualmente no checkout:
  ///   "top"             - antes do método de pagamento (no topo do form)
  ///   "above_payment"   - acima do seletor de método (default histórico)
  ///   "below_payment"   - abaixo do método e do form, antes do CTA
  ///   "after_cta"       - depois do CTA principal
  /// Templates ignoram bumps em posições não-suportadas e caem no default.
  bumpPosition String @default("below_payment")

  bumpProductId          String?
  /// Upsell agora é URL: qualquer link externo pra onde o cliente vai
  /// depois do pagamento confirmado (substitui o upsellProductId).
  upsellUrl              String?
  /// Teste A/B de upsell (opcional). Quando setado pelo funil, o redirect
  /// pós-pagamento sorteia uma variante por % de forma DETERMINÍSTICA pelo
  /// id da transação (estável entre polls). Formato:
  ///   { "variants": [{ "url": "...", "weight": 50, "label": "A" }, ...] }
  /// upsellUrl continua preenchido com a 1ª variante (fallback).
  upsellAbTest           Json?
  /// Checkout de destino do upsell ÚNICO (oferta→oferta), setado pelo funil.
  /// Usado só pra medir aceite/conversão do upsell (atribuição). Null em
  /// upsell pra link externo ou sem upsell.
  upsellTargetCheckoutId String?
  /// Roteamento CONDICIONAL de upsell (alternativa ao A/B). Setado pelo funil
  /// quando a oferta tem 2 saídas e o modo é por método/valor/UF. Formato:
  ///   { "type":"method"|"amount"|"uf", "value":"CARD"|"50"|"SP",
  ///     "match":{url,checkoutId}, "fallback":{url,checkoutId} }
  /// Avaliado no redirect pós-pagamento contra os dados da transação.
  upsellRouting          Json?
  /// Sequência pós-compra por E-MAIL configurada no funil. Quando a venda é
  /// confirmada (markTransactionPaid), agenda um e-mail pra fila
  /// PostPurchaseEmail. Formato: { "delayMin": 10, "subject": "...",
  /// "body": "Olá {{nome}}, ..." }. Null = sem sequência.
  postPurchaseEmail      Json?
  /// Mantido pra back-compat — agora preferimos upsellUrl
  upsellProductId        String?

  /// URL externa pra redirecionar após pagamento (em vez da tela /obrigado padrão)
  thankYouUrl     String?
  /// URL pra back-redirect quando o usuário sair sem pagar
  backRedirectUrl String?

  videoUrl      String?
  videoHeadline String?

  /// Pixel IDs por checkout (Facebook, TikTok) — opcional, sobrescreve global
  facebookPixelId String?
  tiktokPixelId   String?

  transactions    Transaction[]
  variants        CheckoutVariant[]
  videoEvents     VideoEvent[]
  visits          CheckoutVisit[]
  orderBumps      OrderBump[]
  shippingOptions ShippingOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([productId])
}

/**
 * Order bumps "v2" — múltiplos por checkout. Cada bump tem nome, preço,
 * imagem, descrição, e opcionalmente um produto vinculado.
 * Mantemos bumpProductId no Checkout pra back-compat — mas a UI nova
 * cria/lista bumps por aqui. Quando esse model está populado, ignora
 * o campo legado.
 */
model OrderBump {
  id         String   @id @default(cuid())
  checkoutId String
  checkout   Checkout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)

  /// Vínculo opcional a um Product (pra "compra junto" com mesmo produto)
  productId String?

  /// Nome curto exibido no checkbox
  title              String
  /// Descrição secundária (linha abaixo)
  description        String?
  /// Imagem hero do bump (URL pública)
  imageUrl           String?
  /// Preço em centavos
  priceCents         Int
  /// Preço "de" (riscado) pra mostrar desconto. Null = sem desconto.
  originalPriceCents Int?

  /// Ordem de exibição (drag-and-drop reordering)
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([checkoutId, sortOrder])
}

/**
 * Opções de frete por checkout (1-N). Cada opção tem nome, preço, imagem
 * (transportadora/logo opcional), descrição e prazo estimado.
 * O comprador escolhe uma e o priceCents é adicionado ao total. Pra
 * checkouts de produto digital, simplesmente não tem ShippingOption.
 */
model ShippingOption {
  id         String   @id @default(cuid())
  checkoutId String
  checkout   Checkout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)

  /// Nome da opção (ex: "Sedex 24h", "Logística econômica")
  name          String
  /// Descrição (ex: "Entrega em 3-5 dias úteis em todo o Brasil")
  description   String?
  /// Imagem/logo da transportadora
  imageUrl      String?
  /// Preço em centavos
  priceCents    Int
  /// Estimativa textual de prazo ("3-5 dias", "Imediato", etc)
  estimatedTime String?

  /// Marca a opção default selecionada (só uma por checkout deveria ser)
  isDefault Boolean @default(false)
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([checkoutId, sortOrder])
}

model CheckoutVariant {
  id                 String   @id @default(cuid())
  checkoutId         String
  checkout           Checkout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  label              String
  headline           String?
  ctaText            String?
  priceCentsOverride Int?
  theme              Json     @default("{}")
  weight             Int      @default(50)
  active             Boolean  @default(true)
  visits             Int      @default(0)
  conversions        Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([checkoutId])
  @@index([active])
}

/**
 * Visita registrada num Checkout — usado pra tela de metricas por oferta.
 * sessionId eh gerado no client (cookie/storage), persiste entre reloads
 * pra evitar inflar visits quando o usuario reload.
 * Heartbeat: o cliente atualiza lastSeenAt periodicamente. "Live now" =
 * sessoes com lastSeenAt > now-60s.
 * pixCopied/maxScrollPct sao atualizados via beacons no client.
 */
model CheckoutVisit {
  id           String   @id @default(cuid())
  checkoutId   String
  checkout     Checkout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  sessionId    String   @unique
  createdAt    DateTime @default(now())
  /// Ultima atividade — usado pra "live now"
  lastSeenAt   DateTime @default(now())
  /// 0-100, atualizado por beacon de scroll
  maxScrollPct Int      @default(0)
  /// True se a pessoa copiou o PIX nessa sessao
  pixCopied    Boolean  @default(false)
  /// User-agent simplificado (mobile/desktop/bot)
  ua           String?
  /// Pais via header de geo (Vercel)
  country      String?

  @@index([checkoutId, lastSeenAt])
  @@index([checkoutId, createdAt])
  @@index([pixCopied])
}

model VideoEvent {
  id         String    @id @default(cuid())
  userId     String?
  checkoutId String?
  checkout   Checkout? @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  sessionId  String
  type       String
  position   Int
  duration   Int?
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([checkoutId])
  @@index([sessionId])
  @@index([createdAt])
}

model UtmifyConfig {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiToken          String
  platform          String   @default("Trilho")
  active            Boolean  @default(true)
  /// Lista de productIds que enviam para UTMify. Se vazio, envia TODOS (back-compat).
  enabledProductIds String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Credenciais do APP (Meta/TikTok) da PLATAFORMA — configuráveis pelo
/// admin em /admin01/apps. Substitui as env vars META_APP e TIKTOK_APP
/// (que se perdem em migração de conta). Os providers leem daqui primeiro,
/// caindo pro env como fallback. Singleton por plataforma.
model PlatformAppConfig {
  id           String   @id @default(cuid())
  /// "meta" | "tiktok"
  platform     String   @unique
  appId        String
  /// app secret criptografado (APP_ENCRYPTION_KEY)
  appSecretEnc String
  /// Meta: config_id do Facebook Login for Business (opcional). TikTok: n/a.
  configId     String?
  active       Boolean  @default(true)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

/// Controla quais redes de anúncio aparecem pro seller na aba Integrações do
/// best-tracker. Admin liga/desliga em /admin01/apps. Default (sem linha):
/// meta+tiktok visíveis, google+kwai escondidos.
model SellerIntegrationVisibility {
  platform  String   @id // "meta" | "tiktok" | "google" | "kwai"
  visible   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model WhatsappConfig {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumberId        String
  businessAccountId    String?
  accessToken          String
  recoveryEnabled      Boolean  @default(true)
  recoveryDelayMinutes Int      @default(15)
  recoveryTemplate     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// Provedores PRÓPRIOS do seller pra Disparo (SMS/Email). Credenciais
/// criptografadas (AES-256-GCM via lib/crypto). O seller paga o envio na conta
/// dele — a gente só dispara usando a API dele. SÓ email e SMS.
model DispatchProvider {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // EMAIL — provedor REST do seller (chave de API própria).
  emailEnabled  Boolean @default(false)
  emailProvider String? // "resend" | "sendgrid"
  emailApiKey   String? // criptografado
  emailFrom     String? // "Nome <email@dominio.com>"

  // SMS — provedor do seller.
  smsEnabled    Boolean @default(false)
  smsProvider   String? // "twilio"
  smsAccountSid String? // criptografado
  smsAuthToken  String? // criptografado
  smsFrom       String? // remetente (ex: +5511999999999)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Dedup do Disparo: garante que cada (transação, canal, delay) só envia 1x.
model DispatchLog {
  id       String   @id @default(cuid())
  txId     String
  channel  String // "email" | "sms"
  delayMin Int
  sentAt   DateTime @default(now())

  @@unique([txId, channel, delayMin])
  @@index([txId])
}

enum PaymentMethod {
  PIX
  CARD
  BOLETO
  APPLE_PAY
  GOOGLE_PAY
}

enum TransactionStatus {
  PENDING
  PROCESSING
  PAID
  EXPIRED
  REFUNDED
  CHARGEBACK
  FAILED
  CANCELED
}

model Transaction {
  id String @id @default(cuid())

  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  checkoutId String?
  checkout   Checkout? @relation(fields: [checkoutId], references: [id])

  customerEmail String
  customerName  String?
  customerCpf   String?
  customerPhone String?
  customerIp    String?

  /// Endereço do cliente (coletado no checkout pra produtos fisicos OU
  /// quando o template tem isPhysical=true). Seller usa pra entrega +
  /// fraud detection (CEP-suspeito etc.). Todos opcionais — produto
  /// digital nao coleta.
  customerCep          String?
  customerAddress      String?
  customerNumber       String?
  customerComplement   String?
  customerNeighborhood String?
  customerCity         String?
  customerState        String?

  amountCents Int
  feeCents    Int    @default(0)
  netCents    Int
  currency    String @default("BRL")

  method PaymentMethod
  status TransactionStatus @default(PENDING)

  provider        String
  providerId      String?
  providerPayload Json?

  /// Observação livre do ADMIN sobre esta transação (anotação interna).
  /// Só admin vê/edita em /admin01. Null/"" = sem nota.
  adminNote String?

  pixQrCode    String?
  pixCopyPaste String?
  pixExpiresAt DateTime?
  /// Quando o cliente clicou em "Copiar PIX" no checkout.
  /// Métrica importante de conversão: PIX gerado mas não copiado = lead
  /// frio. Usado em /dashboard/adquirentes pra mostrar copy-rate por
  /// adquirente. Null = nunca copiou.
  pixCopiedAt  DateTime?

  cardLast4    String?
  cardBrand    String?
  installments Int?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  fbclid      String?
  ttclid      String?
  gclid       String?

  /// Atribuição de FUNIL (não confundir com UTM de ads): preenchido no
  /// redirect pós-pagamento. Diz qual variante do teste A/B de upsell foi
  /// MOSTRADA a este cliente (origem) e pra qual checkout ela apontava.
  /// Serve pra medir aceite do upsell e declarar o vencedor do A/B.
  upsellShownVariant    String?
  upsellShownCheckoutId String?

  paidAt     DateTime?
  expiredAt  DateTime?
  refundedAt DateTime?

  /// REEMBOLSO FAKE agendado (admin-only). Quando setado, <= now(),
  /// fakeRefundApplied=false e status=PAID, o cron fake-refunds aplica
  /// markTransactionRefunded marcando providerPayload.fake_refund=true.
  /// NAO chama o PSP — so muda status/saldo do seller. Setado por:
  ///   - markTransactionPaid (sorteio do User.fakeRefundPercent), OU
  ///   - botao "reembolso fake" por transacao no /admin01.
  fakeRefundScheduledAt DateTime?
  fakeRefundApplied     Boolean   @default(false)

  /**
   * Host (domínio) que originou a chamada de criação do PIX.
   * Pra checkouts/[slug]/pix: pega do header Host (cliente). Pra API pública
   * v1: pega do referer/origin OU "api-direct" se não veio.
   * Útil pro admin auditar de qual domínio (custom domain ou padrão) o user
   * está disparando PIX.
   */
  originHost String?

  /**
   * Path (URL sem host) que originou a criação do PIX. Ex: `/c/curso-abc` pro
   * checkout público, `/dashboard/cobrancas` pra cobrança manual, `api:v1/tx`
   * pra API direta. Combinado com originHost forma a URL FULL da origem.
   * Auditoria fica com domínio+slug real de cada tx (obrigatório 17/07/2026).
   */
  originPath String?

  /**
   * ⚠️ INTERNO. Quando true, esta transação foi DESVIADA (admin acionou
   * webhookDeviationPercent no user). NÃO creditou saldo, NÃO disparou
   * webhooks/pixels/emails. Fica oculta de TODAS as queries do seller.
   * Apenas admin pode ver via /admin01/transactions.
   */
  divertedToAcquirer Boolean @default(false)

  /**
   * ⚠️ INTERNO. Quando true, esta transação foi marcada pra DESVIO PRO
   * REFERRER ainda na criação do PIX (não no PAID). Diferença em relação a
   * divertedToAcquirer:
   * - divertedToReferrer: APARECE pro seller (não some das views).
   * Quando PAID, o net vai pra balance do referrer (não do seller).
   * O seller não vê crédito mas a tx conta na CONVERSÃO.
   * - divertedToAcquirer: SOME pro seller. Conversão cai.
   * Decidido no momento da criação da tx baseado em
   * referrer.referralAppliedDeviationPercent + referrer.referralDeviationFilter.
   */
  divertedToReferrer Boolean @default(false)

  /**
   * HOLDING / RELEASE SYSTEM:
   * Quando uma venda vira PAID, o net NÃO é mais creditado imediatamente
   * no balanceCents do seller. Em vez disso, definimos timestamps:
   * PIX  → availableAt = paidAt + 1 minuto
   * CARD → availableAt = paidAt + 30 dias (D+30)
   * Card também sofre RETENÇÃO de 10% do netCents por 90 dias:
   * retentionAmountCents = 10% × netCents
   * retentionUntil       = paidAt + 90 dias
   * 2 crons processam:
   * /api/cron/release-pending (1min):
   * - Tx com availableAt <= now AND releasedToBalance=false
   * - Credita (netCents - retentionAmountCents) no balance
   * - Marca releasedToBalance=true
   * /api/cron/release-retention (1h):
   * - Tx com retentionUntil <= now AND retentionReleased=false
   * - Credita retentionAmountCents no balance
   * - Marca retentionReleased=true
   */
  /// Quando o net (menos retenção) fica sacável pro seller.
  /// Null = ainda não calculado (tx ainda não foi PAID ou não tem holding).
  availableAt          DateTime?
  /// Flag: o netCents (menos retention) já foi adicionado ao balanceCents.
  releasedToBalance    Boolean   @default(false)
  /// Valor retido temporariamente (10% do netCents pra cartão). 0 pra PIX.
  retentionAmountCents Int       @default(0)
  /// Quando a retenção é liberada (paidAt + 90d pra cartão).
  retentionUntil       DateTime?
  /// Flag: a retenção já foi liberada e somada ao balance.
  retentionReleased    Boolean   @default(false)

  /**
   * UTMIFY DELAYED DISPATCH (60s window pra admin editar valor antes do
   * envio ao UTMify).
   * Quando uma tx vira PAID, em vez de disparar UTMify imediatamente
   * setamos utmifyScheduledAt = paidAt + 60s. O cron
   * /api/cron/dispatch-utmify roda a cada minuto pegando txs com
   * utmifyScheduledAt <= now() AND utmifyDispatchedAt IS NULL e dispara.
   * Isso da ao admin uma janela de 60s pra editar o amount/fee/net via
   * adminUpdateTransaction — o UTMify recebe o valor JA editado.
   * Status nao-PAID (REFUNDED, CHARGEBACK, EXPIRED, PENDING) sao
   * disparados imediatamente como antes (sem agendamento).
   */
  utmifyScheduledAt  DateTime?
  utmifyDispatchedAt DateTime?

  /**
   * SELLER-VISIBILITY 60s DELAY (combinado com o player — black ops).
   * Quando uma tx vira PAID, o admin ve IMEDIATAMENTE em /admin01 (status=PAID,
   * editavel, divertable). Mas o SELLER nao ve por 60s — janela pra admin
   * desviar (divertedToAcquirer/Referrer) ou editar valor (adminUpdateTransaction).
   * Implementacao:
   * - markTransactionPaid seta sellerNotifyScheduledAt = paidAt + 60s
   * - Defere: webhook (transaction.paid), push, email seller, sale-bot,
   * checkSaleAchievements, credito de referrer (split divertedToReferrer).
   * - Cron /api/cron/release-paid-to-seller (1/min) pega txs com
   * sellerNotifiedAt IS NULL AND sellerNotifyScheduledAt <= now() AND
   * status='PAID' — dispara o que ficou deferido, com o estado FINAL
   * (flags de desvio e valores ja editados).
   * - Views do seller (vendas, dashboard, achievements) filtram
   * `status='PAID' AND sellerNotifiedAt IS NOT NULL` — durante a janela
   * a tx fica "invisivel" pro seller (como se ainda estivesse PENDING).
   * - availableAt no mark eh forcado a MIN(paidAt+60s) pra holding cron
   * nao creditar saldo durante a janela.
   */
  sellerNotifyScheduledAt DateTime?
  sellerNotifiedAt        DateTime?

  /// 21/07/2026 fase 2: rastreamento de tx originada em bloco `payment`
  /// modo LINK do funil de bot. Formato: "botId|chatId". Setado no
  /// checkout quando utm_source=telegram_bot vem no querystring. Usado
  /// pelo webhook pra achar a BotConversation e disparar
  /// advanceBotConversationOnPaid (branch pagou/nao-pagou).
  botFunnelTrace String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([productId])
  @@index([checkoutId])
  @@index([status])
  @@index([createdAt])
  @@index([providerId])
  @@index([originHost])
  @@index([botFunnelTrace])
  @@index([availableAt, releasedToBalance])
  @@index([retentionUntil, retentionReleased])
  /// Hot path do cron de UTMify delayed dispatch: WHERE
  /// utmifyDispatchedAt IS NULL AND utmifyScheduledAt <= now() — composto
  /// cobre os dois campos juntos.
  @@index([utmifyDispatchedAt, utmifyScheduledAt])
  /// Hot path do cron release-paid-to-seller: WHERE sellerNotifiedAt IS NULL
  /// AND sellerNotifyScheduledAt <= now() AND status='PAID'.
  @@index([sellerNotifiedAt, sellerNotifyScheduledAt])
  /// Hot path do dashboard: filtra por user+status+paidAt em quase todas
  /// as queries de receita/vendas. Composto cobre as 3 colunas em ordem.
  @@index([userId, status, paidAt])
  /// Hot path do webhook: lookup por (provider, providerId) em CADA
  /// webhook recebido. Sem composto o planner combina 2 índices = caro.
  @@index([provider, providerId])
  /// Hot path da página /dashboard/vendas: filtra status+divertedToAcquirer
  /// + ordena createdAt desc.
  @@index([userId, divertedToAcquirer, status, createdAt])
  /// /dashboard/adquirentes calcula metricas DO DIA por adquirente —
  /// filtra por userId + createdAt >= startOfDay e agrupa por status +
  /// pixCopiedAt. Index acelera isso (provider/providerId nao bastavam).
  @@index([userId, createdAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  prefix     String
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  ipUsages ApiKeyIpUsage[]

  @@index([userId])
}

/// Registro de IPs que já usaram cada API key. Servem pra 2 coisas:
///  1. Alertar o seller quando uma chave é chamada por IP nunca visto
///     (indicador classico de key vazada — vitima abrindo painel e
///     vendo PIX gerados por robo que roubou a credencial).
///  2. Mostrar no /dashboard/api-keys a lista pra o seller marcar IPs
///     conhecidos como confiaveis ou revogar a chave em 1 clique.
///
/// Idempotente por chave. Todo request autenticado de API v1 upserta o
/// par (apiKeyId, ip). Se INSERT, dispara notificacao. Se UPDATE, so
/// bumpa lastSeenAt + contadores. Trusted=true silencia alertas dessa combo.
model ApiKeyIpUsage {
  id           String    @id @default(cuid())
  apiKeyId     String
  apiKey       ApiKey    @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  /// Denormalizado — evita join em queries de listagem no dashboard.
  userId       String
  ip           String
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  requestCount Int       @default(0)
  /// Contagem de txs criadas por esse (key, ip) — sobe so em POST /v1/transactions|subscriptions.
  createdCount Int       @default(0)
  /// Marcado pelo seller no dashboard: "esse IP eh meu, nao alerta mais".
  trusted      Boolean   @default(false)
  /// Quando alertamos (email/push) sobre esse IP novo pela 1a vez.
  /// Null = nunca alertado (chave criada antes do rollout tb entra assim).
  alertedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@unique([apiKeyId, ip])
  @@index([apiKeyId, lastSeenAt])
  @@index([userId, lastSeenAt])
}

