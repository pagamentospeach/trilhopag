/**
 * ============ Multi-acquirer (Pix processors) ============
 */

model Acquirer {
  id                       String  @id @default(cuid())
  /// Código interno (safepix, shipay, paggue, etc.)
  code                     String  @unique
  /// Nominal: nome que aparece no recebedor do Pix
  /// (ex.: "CENTRAL DE PAGAMENTOS DIGITAIS LTDA")
  nominalName              String
  /// Sigla de 3 letras mostrada no UI (ex.: RT, PGN, IUP)
  shortCode                String
  active                   Boolean @default(true)
  /// Categoria da adquirente. Valores válidos: ACQUIRER_MODES em
  /// src/lib/ops-modes.ts = os modos de conta (black, white, hot, sag) MAIS
  /// dois COMBINADOS que só existem deste lado: "both" (serve black e white)
  /// e "white_hot" (serve white e hot).
  /// Quem decide qual conta enxerga qual categoria é ACQUIRER_MODES_FOR no
  /// mesmo arquivo — é essa tabela que o dispatch de PIX e de cartão consulta.
  /// SAG é EXCLUSIVO: não entra em "both", então uma conta sag só vê o que o
  /// admin marcar explicitamente como `mode = "sag"`.
  mode                     String  @default("black")
  /// Toggle global do ADMIN: se `false`, NINGUÉM pode ver/usar essa adquirente.
  /// Quando admin desativa, todos os UserAcquirer dessa adquirente são
  /// movidos pra próxima disponível automaticamente.
  globalEnabled            Boolean @default(true)
  /// Observação livre do ADMIN sobre essa adquirente. Aparece como tag
  /// pequena ao lado do nominal pros sellers QUANDO estiver preenchida
  /// (vazio = sem tag visível). Útil pra status tipo "instável hoje",
  /// "promoção -50% até sábado", "BACEN suspendeu", etc.
  adminNote                String?
  /// Se true, NUNCA atualiza Acquirer.nominalName automaticamente a partir
  /// do QR Code retornado pelo PSP. Útil quando o admin quer manter um
  /// nominal "comercial" mesmo que o PSP retorne nome diferente no QR
  /// (ex: PSP rebrandou o recebedor mas a gente quer manter "Trilho
  /// Pagamentos" como nominal).
  lockNominalName          Boolean @default(false)
  /// Instituição/PSP por trás da nominal, extraída AUTOMATICAMENTE do código
  /// PIX (domínio do URL dinâmico na tag 26 do EMV — ex.: "onlyup" de
  /// pix.onlyup.com.br, "owem" de qrcode.owem.com.br, "basspago" de
  /// pix.basspago.com.br). Exibida ao lado da nominal como "Nominal - instituição".
  /// Null quando o PIX usa chave estática (sem URL) e não dá pra inferir.
  /// Atualiza junto com nominalName (respeita lockNominalName).
  institution              String?
  /// Quando true, a adquirente NÃO aparece em NENHUMA tela do seller (lista de
  /// adquirentes, seletor por produto, cobranças) E NÃO RECEBE ROTEAMENTO —
  /// nem PIX, nem cartão, nem como fallback do fanout.
  ///
  /// 05/08/2026 (davi: "quando a adquirente ta escondida, nao pode ser gerado
  /// nenhum pix nela! so nas que tao mostrando pro seller! O fallback so
  /// funciona pra adquirentes visiveis pro seller!"). ANTES desta data o
  /// dispatcher ignorava esta flag de propósito e escondida processava normal.
  /// O que derrubou aquela regra: a safepix-5 estava escondida e mesmo assim
  /// era a adquirente que MAIS processava (469 tx/dia), concentrando 100% dos
  /// reembolsos — e nenhum seller conseguia vê-la nem desligá-la.
  ///
  /// Regra atual, em uma linha: se o seller não vê, não roda.
  /// Diferente de globalEnabled=false, que DESLIGA pra todo mundo mas
  /// mantém a adquirente listável/administrável no /admin01.
  hiddenFromSellers        Boolean @default(false)
  supportsPix              Boolean @default(true)
  supportsCard             Boolean @default(false)
  supportsBoleto           Boolean @default(false)
  supportsApplePay         Boolean @default(false)
  supportsGooglePay        Boolean @default(false)
  /// Prioridade GLOBAL (menor = primária). Sobrescreve a ordem padrão de
  /// fallback quando o usuário não tem UserAcquirer configurada e também
  /// é usada como tiebreaker quando duas têm a mesma userPriority.
  priority                 Int     @default(100)
  /// Fee adicional cobrado pela adquirente (acima da fee do gateway)
  extraFeePercent          Float   @default(0)
  /// CUSTO que o GATEWAY paga pra essa adquirente, por transação PIX.
  /// Ex.: SafePix cobra 4,99% + R$ 1,00 (cents=100) por PIX aprovado.
  /// Usado pra calcular o LUCRO REAL da plataforma:
  ///   real_profit = sellerFee - referrerEarnings - acquirerCost
  pixCostPercent           Float   @default(4.99)
  pixCostFixedCents        Int     @default(100)
  /// Custo pra cartão (caso aplicável)
  cardCostPercent          Float   @default(0)
  cardCostFixedCents       Int     @default(0)
  /// CUSTO FIXO que o GATEWAY paga pra essa adquirente por SAQUE/transferência
  /// (saída de dinheiro). Diferente do pixCost* (que é por COBRANÇA). Ex.:
  /// SafePix R$ 2,50 (cents=250), FlevoPay R$ 3,50 (cents=350). Usado no cálculo
  /// do lucro REAL de saque no painel admin (cruzando Withdrawal.providerAccount).
  withdrawalCostFixedCents Int     @default(250)

  /**
   * SURCHARGE DE TAXA do SELLER quando a tx eh roteada por essa adquirente.
   * Soma ao fee normal do seller. Exemplo: seller paga 5,99%+R$2 e essa
   * adquirente tem extraSellerFeePercent=1.5 + extraSellerFeeFixedCents=50
   * → seller paga 7,49% + R$ 2,50 nessa adquirente.
   * Aplicado POS-DISPATCH (depois de saber qual adquirente foi escolhida).
   * Permite cobrar diferente por adquirente sem mexer no perfil do seller.
   */
  extraSellerFeePercent    Float @default(0)
  extraSellerFeeFixedCents Int   @default(0)
  /**
   * OVERRIDE no % de DESVIO quando essa adquirente eh usada. Soma ao
   * referralAppliedDeviationPercent do seller. Ex: seller tem 10% de
   * desvio e essa adquirente tem extraDiversionPercent=5 → 15% de chance
   * de a tx ser desviada quando passa por essa adquirente.
   * Cap em 100.
   */
  extraDiversionPercent    Float @default(0)

  /**
   * REEMBOLSO FAKE por ADQUIRENTE. Quando uma venda é roteada por esta
   * adquirente, além do sorteio do User.fakeRefundPercent, sorteia também
   * este %: se bater, a venda vira REFUNDED automaticamente daqui a
   * fakeRefundDelayDays (cron fake-refunds). NÃO chama o PSP. 0 = desligado.
   */
  fakeRefundPercent   Float @default(0)
  fakeRefundDelayDays Int   @default(7)

  /**
   * AJUSTE MANUAL DE SALDO (signed, em cents). Admin pode somar/subtrair
   * pra ajustar o saldo exibido. Para acquirers com API, soma ao API
   * balance. Para calculadas, soma ao saldo estimado.
   * Util pra reconciliar com saldo real do banco quando ha diff vs API.
   */
  balanceAdjustmentCents Int @default(0)

  /// Credenciais da conta da adquirente (encriptadas com APP_ENCRYPTION_KEY).
  /// Permite ter MÚLTIPLAS contas da MESMA adquirente (ex: 2 contas SafePix).
  /// Nullable porque adquirentes legacy podem usar env vars (fallback).
  publicKey    String?
  secretKeyEnc String?
  companyId    String?

  /// E-mail da CONTA da adquirente (login no PSP). Admin-only, plaintext — é só
  /// um identificador da conta, não um segredo. Exibido na aba de adquirentes
  /// pra saber a qual conta cada nominal pertence.
  accountEmail String?

  /// Metadata adicional encriptado (JSON) — pra adquirentes que precisam de
  /// mais que public+secret (ex: Mercado Pago precisa de client_id+client_secret,
  /// Stripe precisa de webhook_signing_secret, etc).
  metadataEnc String?

  /// PRIVATE ACQUIRER (05/07/2026): quando true, so aparece pros sellers
  /// cujo email esta em privateAllowedEmails. Todas as outras views seller-
  /// facing (adquirentes/cobrancas/produtos/dispatch) filtram usando esta
  /// combinacao. Admin em /admin01/acquirers marca via toggle + editor de
  /// lista. Comparacao case-insensitive/trim. Default false = comportamento
  /// antigo (visivel pra todos os sellers, respeitando hiddenFromSellers).
  isPrivate            Boolean  @default(false)
  privateAllowedEmails String[] @default([])

  /// DENYLIST por email (07/07/2026). Independente de isPrivate/publica, esses
  /// emails NAO veem essa adquirente. Uso: adquirente publica que voce quer
  /// esconder de 1-2 sellers em especifico (ex: seller reclamando de fee,
  /// seller de teste). Vale POR CIMA de qualquer outra visibilidade — se o
  /// email do seller esta aqui, a adquirente some das telas dele. Case-
  /// insensitive/trim. Admin edita no toggle + editor de lista na aba admin.
  hiddenFromEmails String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userAcquirers    UserAcquirer[]
  productOverrides Product[]               @relation("ProductAcquirerOverride")
  nominalChanges   AcquirerNominalChange[]

  @@index([active])
  @@index([mode])
  @@index([isPrivate])
}

/// HISTORICO de troca de nominal de uma adquirente.
/// Toda vez que maybeUpdateNominal (em lib/acquirers.ts) detecta no QR do PSP
/// um nome de recebedor DIFERENTE do atual (e a adquirente nao esta com
/// lockNominalName), grava aqui o antes/depois. Util pro admin avisar os
/// sellers "a nominal X virou Y".
model AcquirerNominalChange {
  id         String   @id @default(cuid())
  acquirerId String
  acquirer   Acquirer @relation(fields: [acquirerId], references: [id], onDelete: Cascade)
  oldNominal String
  newNominal String
  createdAt  DateTime @default(now())

  @@index([acquirerId, createdAt])
  @@index([createdAt])
}

/// Flags globais da plataforma (singleton por chave). Substitui env vars
/// pra config runtime que admin liga/desliga em painel. Ex.:
/// - "acquirer_nominal_dedup_auto" → otimizacao automatica de adquirentes
///   (quando 2+ acquirers passam a ter o mesmo nominal, esconde dos sellers
///    a que tiver conversao mais baixa no dia).
model PlatformFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model UserAcquirer {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  acquirerId    String
  acquirer      Acquirer @relation(fields: [acquirerId], references: [id], onDelete: Cascade)
  /// Ordem de prioridade — menor = mais alta. 0 é a primária.
  /// Mantido por compat — hoje usamos pixPriority/cardPriority abaixo.
  priority      Int      @default(0)
  active        Boolean  @default(true)
  /// Per-method priority (separa PIX de cartão).
  pixPriority   Int      @default(0)
  pixActive     Boolean  @default(true)
  cardPriority  Int      @default(0)
  cardActive    Boolean  @default(true)
  /// Stats acumulados pra exibir taxa de conversão na UI
  totalAttempts Int      @default(0)
  totalApproved Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, acquirerId])
  @@index([userId])
  @@index([userId, priority])
}

model AcquirerTest {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// IDs das adquirentes participando
  acquirerIds       String[]
  /// Status: running | completed | canceled
  status            String    @default("running")
  /// Meta de transações por adquirente
  txTargetPerAcq    Int       @default(20)
  /// Resultados acumulados (acquirerId → {attempts, approved})
  results           Json      @default("{}")
  /// Adquirente vencedora (definida quando completed)
  winnerAcquirerId  String?
  /// Quando true, ao completar o teste a vencedora é MOVIDA pro topo (pixPriority=0)
  /// automaticamente — elimina passo manual pro seller (17/07/2026, davi).
  autoPromoteWinner Boolean   @default(false)
  /// Motivo do cancelamento — exibido no histórico. null pra tests running/completed
  /// ou cancelados manualmente sem contexto. Ex: "adquirentes indisponíveis"
  /// quando o auto-cancel detecta que todas as adquirentes do teste sumiram.
  cancelReason      String?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?

  @@index([userId, status])
}

/**
 * ============ Ad Platform Accounts (Meta / TikTok / Google / Kwai) ============
 */

model AdAccount {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation("UserAdAccounts", fields: [userId], references: [id], onDelete: Cascade)
  /// "meta" | "tiktok" | "google" | "kwai"
  platform       String
  /// FB user id (do dono), TT advertiser id, etc.
  externalUserId String
  /// Nome do perfil dono da conta (FB user name) — cache pra UI evitar fetch
  profileName    String?
  /// id da CONTA de anúncio (act_1234567 no Meta)
  accountId      String
  accountName    String
  /// Moeda da conta de anúncio (ISO: "BRL", "USD", "CLP"...). Capturada no
  /// sync (best-effort). Usada SÓ pra formatar o gasto na tela de Campanhas —
  /// não afeta saldo/transações do gateway (essas são sempre BRL).
  currency       String?
  /// Taxa de câmbio MANUAL pra BRL (override). Quando setado, o gateway usa
  /// essa taxa pra converter o gasto desta conta (em vez da cotação ao vivo).
  fxRateOverride Float?
  /// Token de acesso CRIPTOGRAFADO (AES-GCM com APP_ENCRYPTION_KEY)
  accessToken    String
  refreshToken   String?
  expiresAt      DateTime?
  scope          String?
  /// "active" | "expired" | "revoked"
  status         String    @default("active")
  /// Se a conta está habilitada pra sincronizar (toggle do user). Se false, cron pula.
  enabled        Boolean   @default(true)
  /// Última vez que sincronizamos campanhas/insights
  lastSyncAt     DateTime?
  syncError      String?
  /// Pixels conectados a essa conta de anúncio. Array de objetos:
  /// [{ id: "1234", name: "Meu Pixel BR", isDefault?: true }]
  /// Atualizado pelo cron de sync (Meta Marketing API / TikTok Pixel API).
  /// Permite o user escolher PELO NOME ao criar mass campaign.
  pixels         Json      @default("[]")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  campaigns AdCampaign[]

  @@unique([userId, platform, accountId])
  @@index([userId, platform])
  @@index([status])
}

model AdCampaign {
  id                  String    @id @default(cuid())
  adAccountId         String
  adAccount           AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  externalId          String // ID da campanha no Meta/TikTok/etc
  name                String
  /// "ACTIVE" | "PAUSED" | "DELETED" | "ARCHIVED"
  status              String
  objective           String?
  dailyBudgetCents    Int?
  lifetimeBudgetCents Int?
  /// Meta de ROAS dessa campanha (override por campanha). Null = usa o default
  /// global do seller (UserSettings.adTargetRoas). Pinta a linha verde/vermelha.
  targetRoas          Float?
  /// Dedup do alerta "queimando dinheiro" (push). Setado quando a gente avisa;
  /// reseta no sync quando a campanha deixa de queimar. Evita spam de push.
  alertedBurnAt       DateTime?
  /// Dedup do auto-scale ("escalar vencedora"). Setado quando sobe o budget;
  /// a regra só sobe de novo após 24h.
  lastScaledAt        DateTime?
  /// ⭐ Campanha favoritada (vencedora) — aparece no topo do dashboard.
  favorite            Boolean   @default(false)
  /// Insights agregados (atualizados no sync)
  spendCentsDay       Int       @default(0)
  spendCentsTotal     Int       @default(0)
  impressions         Int       @default(0)
  clicks              Int       @default(0)
  ctrPercent          Float?
  cpcCents            Int?
  cpmCents            Int?
  externalUpdatedAt   DateTime?
  lastSyncAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  adsets AdAdset[]

  @@unique([adAccountId, externalId])
  @@index([adAccountId, status])
}

model AdAdset {
  id               String     @id @default(cuid())
  campaignId       String
  campaign         AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  externalId       String
  name             String
  status           String
  dailyBudgetCents Int?
  spendCentsDay    Int        @default(0)
  spendCentsTotal  Int        @default(0)
  impressions      Int        @default(0)
  clicks           Int        @default(0)
  lastSyncAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  ads Ad[]

  @@unique([campaignId, externalId])
  @@index([campaignId, status])
}

model Ad {
  id              String    @id @default(cuid())
  adsetId         String
  adset           AdAdset   @relation(fields: [adsetId], references: [id], onDelete: Cascade)
  externalId      String
  name            String
  status          String
  /// Status de entrega/auditoria (TikTok secondary_status / Meta effective_status).
  /// Usado pra detectar anúncio REPROVADO no "Apelação em massa".
  secondaryStatus String?
  /// Motivo da reprovação (quando reprovado), pra mostrar pro seller.
  rejectReason    String?
  spendCentsDay   Int       @default(0)
  spendCentsTotal Int       @default(0)
  impressions     Int       @default(0)
  clicks          Int       @default(0)
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([adsetId, externalId])
  @@index([adsetId, status])
}

model AdRule {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation("UserAdRules", fields: [userId], references: [id], onDelete: Cascade)
  name       String
  platform   String    @default("meta")
  /// {productId?, accountIds?, applyTo: "campaigns"|"adsets"|"ads", filter: "active"|"all", nameFilter?}
  scope      Json
  /// [{ metric: "spend"|"cpa"|"roas"|"roi"|"profit"|"margin"|"cpc"|"ctr"|"impressions",
  ///    op: "gt"|"lt"|"gte"|"lte"|"eq",
  ///    value: number }]
  conditions Json
  /// { type: "pause"|"activate"|"budget_increase"|"budget_decrease"|"notify",
  ///   value?: number (% pra budget actions) }
  action     Json
  /// "15m" | "1h" | "6h" | "24h"
  frequency  String    @default("1h")
  /// "30m" | "1h" | "1d" | "7d"
  window     String    @default("1d")
  active     Boolean   @default(true)
  lastRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  executions AdRuleExecution[]

  @@index([userId, active])
}

model AdRuleExecution {
  id           String   @id @default(cuid())
  ruleId       String
  rule         AdRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ranAt        DateTime @default(now())
  matchedCount Int      @default(0)
  actionTaken  String
  details      Json     @default("{}")
  error        String?

  @@index([ruleId, ranAt])
}

/// Snapshot DIÁRIO de gasto × receita do seller (grão usuário/dia). Escrito
/// pelo sync de ads (upsert por dia — o último write do dia = número final).
/// Alimenta o gráfico de evolução de gasto/ROAS/lucro na tela de ROAS.
model AdSpendSnapshot {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("UserAdSnapshots", fields: [userId], references: [id], onDelete: Cascade)
  /// Dia do snapshot (UTC midnight).
  day          DateTime @db.Date
  spendCents   Int      @default(0)
  revenueCents Int      @default(0)
  sales        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, day])
  @@index([userId, day])
}

// ----------- Bturb (Video hosting / VSL) -----------

model BturbVideo {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserBturbVideos", fields: [userId], references: [id], onDelete: Cascade)

  title           String
  description     String?
  /// URL pública do vídeo (hospedado em Vercel Blob ou source externo)
  videoUrl        String
  /// MIME type, duração e tamanho — preenchidos no upload
  mimeType        String?
  durationSeconds Int?
  sizeBytes       Int?

  /// Thumbnails
  thumbnailUrl      String?
  thumbnailPauseUrl String?
  thumbnailEndUrl   String?

  /// Configurações do player
  smartAutoplay            Boolean @default(true)
  /// Autoplay sem som (compatível com restrições de browser)
  autoplayMuted            Boolean @default(true)
  /// Reproduz silencioso e mostra prompt "click to unmute"
  silentAutoplay           Boolean @default(true)
  /// Velocidade Turbo (player roda 1.25x até primeira interação)
  turboSpeed               Boolean @default(false)
  /// Mostra barra de progresso real
  showProgress             Boolean @default(false)
  /// Barra "fake" — engana a percepção de duração pro user assistir mais
  fakeProgressBar          Boolean @default(true)
  fakeProgressTotalSeconds Int?
  /// Loop infinito
  loop                     Boolean @default(false)
  /// Esconde controles (cliques, seek, etc.)
  hideControls             Boolean @default(true)
  /// Bloqueia clique direito
  blockRightClick          Boolean @default(true)
  /// Proteção contra download (ofusca URL, refresh tokens)
  downloadProtection       Boolean @default(true)
  /// Cor primária do player (hex)
  primaryColor             String  @default("#84CC16")

  /// CTA configurações
  /// CTA aparece em N segundos do vídeo
  ctaDelaySeconds Int?
  ctaText         String?
  ctaUrl          String?
  /// Botão renderizado dentro ou abaixo do vídeo
  ctaPlacement    String  @default("below") // "below" | "overlay"
  /// HTML customizado (substitui o CTA padrão se preenchido)
  ctaCustomHtml   String?

  /// Pixels e tracking
  fbPixelId     String?
  tiktokPixelId String?
  /// Conversion key — chave única pra cruzar play→venda
  conversionKey String?

  /// Stats agregadas (atualizadas pela API de tracking)
  views         Int  @default(0)
  plays         Int  @default(0)
  ctaClicks     Int  @default(0)
  /// Retention buckets — array de [percentual, viewers]
  retentionData Json @default("[]")

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Domínio próprio (verificado, useBturb=true) usado pra servir o embed
  /// (/v/<id>). NUNCA usa trilhopag.com na URL exposta ao tráfego pago
  /// — vide explicação no CloakerCampaign.customDomainId.
  customDomainId String?
  customDomain   CustomDomain? @relation("BturbVideoDomains", fields: [customDomainId], references: [id], onDelete: SetNull)

  events BturbVideoEvent[]

  @@index([userId, active])
  @@index([customDomainId])
}

model BturbVideoEvent {
  id              String     @id @default(cuid())
  videoId         String
  video           BturbVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  /// "view" | "play" | "pause" | "complete" | "cta_click" | "milestone_25" | "milestone_50" | "milestone_75"
  type            String
  /// Visitor único (cookie) pra atribuir conversão
  visitorId       String?
  utmSource       String?
  utmCampaign     String?
  utmMedium       String?
  utmContent      String?
  /// Posição em segundos no momento do evento
  positionSeconds Int?
  /// IP, user-agent etc opcional
  ip              String?
  userAgent       String?
  createdAt       DateTime   @default(now())

  @@index([videoId, type, createdAt])
  @@index([visitorId])
}

// ----------- Trilho Cloaker -----------

model CloakerCampaign {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserCloakerCampaigns", fields: [userId], references: [id], onDelete: Cascade)

  name     String
  /// Slug pra usar como path /c/<slug>
  slug     String @unique
  /// URL "white" — onde robôs, moderadores, Facebook crawler caem (página segura)
  whiteUrl String
  /// URL "money" — onde tráfego pago real é redirecionado (oferta agressiva)
  moneyUrl String

  /// Estratégia de cloaking
  active Boolean @default(true)
  /// Modo de cloaking: "redirect" (302) ou "rewrite" (proxy)
  mode   String  @default("redirect")

  /// === Regras de detecção de bot/moderador ===
  /// Bloquear (mandar pra white) se vier de IP de datacenter conhecido
  blockDatacenterIps Boolean  @default(true)
  /// Bloquear se user-agent for de crawler (Googlebot, FacebookExternalHit, etc)
  blockBotUA         Boolean  @default(true)
  /// Bloquear se vier SEM referer (acesso direto = possivelmente bot/moderador)
  blockNoReferer     Boolean  @default(false)
  /// Bloquear se vier de países específicos (códigos ISO ex: ["US","BR"])
  blockCountries     String[] @default([])
  /// Permitir SOMENTE estes países (whitelist; vazio = qualquer)
  allowCountries     String[] @default([])
  /// Bloquear se vier de proxy/VPN conhecido
  blockProxy         Boolean  @default(true)
  /// Bloquear se vier de uma versão muito antiga de browser (heurística suspeita)
  blockOldBrowsers   Boolean  @default(false)
  /// Exigir que o referer seja de um domínio específico (regex). Vazio = qualquer
  requireReferer     String?

  /// Lista de IPs explicitamente bloqueados
  blockedIps String[] @default([])
  /// Lista de IPs explicitamente permitidos (whitelist override)
  allowedIps String[] @default([])
  /// User agents customizados a bloquear (substring match)
  blockedUAs String[] @default([])

  /// Filtro de UTMs: só passa se tiver utm_source ∈ lista (vazio = qualquer)
  requireUtmSources String[] @default([])

  /// === Estatísticas ===
  totalRequests Int @default(0)
  passedToMoney Int @default(0)
  sentToWhite   Int @default(0)

  /// Domínio próprio (verificado, com useCloaker=true) que vai servir a URL
  /// do cloaker (/cl/<slug>). É OBRIGATÓRIO: a URL nunca pode usar
  /// trilhopag.com, senão o domínio do gateway fica marcado nas plataformas
  /// de anúncio (FB/Google/TT).
  /// Nullable só pra suportar campanhas legacy; novas campanhas exigem.
  customDomainId String?
  customDomain   CustomDomain? @relation("CloakerDomains", fields: [customDomainId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hits CloakerHit[]

  @@index([userId, active])
  @@index([customDomainId])
}

model CloakerHit {
  id          String          @id @default(cuid())
  campaignId  String
  campaign    CloakerCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// "money" (passou) | "white" (bloqueado)
  decision    String
  /// Motivo do bloqueio se white: "bot_ua" | "datacenter_ip" | "blocked_country" | "no_referer" | ...
  reason      String?
  ip          String?
  country     String?
  userAgent   String?
  referer     String?
  utmSource   String?
  utmCampaign String?
  createdAt   DateTime        @default(now())

  @@index([campaignId, createdAt])
  @@index([campaignId, decision])
}

// ----------- Email verification (signup confirmation) -----------

model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation("UserEmailVerificationCodes", fields: [userId], references: [id], onDelete: Cascade)
  email     String
  code      String // 6 dígitos
  /// purpose: "signup" | "reset"
  purpose   String   @default("signup")
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@index([code])
}

/// Fila de e-mails pós-compra agendados pelo funil. Cada venda paga com
/// sequência configurada gera 1 linha (dedup por transactionId). Um cron
/// (process-post-purchase) envia os que já venceram (sendAt <= agora).
model PostPurchaseEmail {
  id            String    @id @default(cuid())
  userId        String
  transactionId String    @unique
  toEmail       String
  subject       String
  bodyHtml      String
  sendAt        DateTime
  /// "PENDING" | "SENT" | "FAILED"
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, sendAt])
  @@index([userId])
}

// ----------- Member Area (Netflix-style) -----------

model MemberArea {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserMemberAreas", fields: [userId], references: [id], onDelete: Cascade)

  /// Slug pra rota /m/<slug>
  slug            String  @unique
  name            String
  description     String?
  /// Logo da área de membros (substitui texto no topo)
  logoUrl         String?
  /// Cor primária (CTAs, destaques)
  primaryColor    String  @default("#84CC16")
  /// Cor secundária (gradientes, hovers)
  accentColor     String  @default("#22C55E")
  /// Cor de fundo
  backgroundColor String  @default("#0A0A0A")
  /// Hero image (banner Netflix-style)
  heroImageUrl    String?
  /// Tagline mostrada no hero
  heroTagline     String?

  /// Domínio customizado opcional (CNAME)
  customDomain String? @unique

  /// Se exige login (true) ou é aberto (false)
  requireLogin Boolean @default(true)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Produtos que dão acesso (a compra desse produto libera essa área)
  productAccess MemberAreaProduct[]
  /// Cursos / categorias / aulas / membros
  categories    MemberCategory[]
  courses       MemberCourse[]
  members       Member[]

  @@index([userId])
}

model MemberAreaProduct {
  id           String     @id @default(cuid())
  memberAreaId String
  memberArea   MemberArea @relation(fields: [memberAreaId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([memberAreaId, productId])
}

model MemberCategory {
  id           String     @id @default(cuid())
  memberAreaId String
  memberArea   MemberArea @relation(fields: [memberAreaId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int        @default(0)
  /// Cor do banner desta categoria
  color        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  courses MemberCourse[]

  @@index([memberAreaId])
}

model MemberCourse {
  id           String          @id @default(cuid())
  memberAreaId String
  memberArea   MemberArea      @relation(fields: [memberAreaId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     MemberCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  title        String
  description  String?
  /// Imagem 16:9 (estilo card Netflix)
  thumbnailUrl String?
  /// Banner widescreen (hero quando entra no curso)
  bannerUrl    String?
  sortOrder    Int     @default(0)

  /// Drip: dia 0 = libera no dia da compra; n = libera N dias após
  dripDay Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules  MemberModule[]
  progress MemberProgress[]

  @@index([memberAreaId, sortOrder])
}

model MemberModule {
  id        String       @id @default(cuid())
  courseId  String
  course    MemberCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  lessons MemberLesson[]

  @@index([courseId, sortOrder])
}

model MemberLesson {
  id       String       @id @default(cuid())
  moduleId String
  module   MemberModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  title       String
  description String?
  /// Tipo: "video" | "text" | "audio" | "pdf" | "embed"
  type        String  @default("video")
  /// URL do conteúdo principal (video, pdf etc)
  contentUrl  String?
  /// Texto/HTML pro tipo "text"
  contentHtml String?
  /// Duração estimada em segundos (pra video)
  durationSec Int?
  /// Materiais extras: array de {name, url}
  attachments Json    @default("[]")

  sortOrder Int  @default(0)
  /// Drip ao nível da aula (sobrescreve o do curso se setado)
  dripDay   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress MemberProgress[]

  @@index([moduleId, sortOrder])
}

model Member {
  id           String     @id @default(cuid())
  memberAreaId String
  memberArea   MemberArea @relation(fields: [memberAreaId], references: [id], onDelete: Cascade)

  email        String
  name         String?
  /// Hash do password (bcrypt)
  passwordHash String?
  /// Auto-login token (link mágico mandado por email)
  loginToken   String? @unique

  /// Data que ganhou acesso (usado pro drip)
  enrolledAt  DateTime  @default(now())
  /// Última vez que logou
  lastLoginAt DateTime?

  /// Bloqueado por inadimplência ou manual
  blocked     Boolean @default(false)
  blockReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress MemberProgress[]

  @@unique([memberAreaId, email])
  @@index([memberAreaId])
}

model MemberProgress {
  id       String       @id @default(cuid())
  memberId String
  member   Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  courseId String
  course   MemberCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   MemberLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  /// Em segundos
  watchedSeconds Int       @default(0)
  /// Marcada como completa
  completed      Boolean   @default(false)
  /// Quando completou
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([memberId, lessonId])
  @@index([memberId, courseId])
}

// ----------- Sale Bots (Discord + Telegram) -----------

model SaleBot {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserSaleBots", fields: [userId], references: [id], onDelete: Cascade)

  /// Plataforma: "discord" | "telegram"
  type     String
  /// Categoria do bot — define quais funções estão habilitadas:
  /// "sales"    — notificação de vendas (default)
  /// "interactive" — venda interativa via comandos (/produtos, /comprar)
  /// "signals"  — sala de sinais (admin manda sinais pra grupo)
  /// "support"  — atendimento (FAQs, links rápidos)
  /// "vip"      — grupo/canal VIP com link gerencial
  category String @default("sales")
  name     String

  /// Telegram: Bot Token (@BotFather)
  /// Discord: pode usar webhookUrl OU botToken+channelId
  botToken   String?
  /// Telegram: chat_id ou @canal
  /// Discord: channelId (se usando bot token)
  chatId     String?
  /// Discord: webhook URL (alternativa ao bot token)
  webhookUrl String?

  /// Template da mensagem com placeholders {product}, {value}, {buyer_name}, {buyer_email}, {payment_method}, {date}
  messageTemplate String

  /// Parse mode pro Telegram: "HTML" | "MarkdownV2" | "None"
  /// Pro Discord, vai como embed se tiver imageUrl/color, senão texto plano
  parseMode String @default("HTML")

  /// Customização visual (mais usado em Discord embed)
  embedColor   String? /// hex "#84CC16"
  imageUrl     String? /// imagem no embed
  thumbnailUrl String? /// thumb no embed

  /// Gatilhos — quais eventos disparam o bot
  triggerSalePaid       Boolean @default(true)
  triggerSalePending    Boolean @default(false)
  triggerSaleRefunded   Boolean @default(false)
  triggerSaleChargeback Boolean @default(false)

  active      Boolean   @default(true)
  /// Estatísticas
  totalSent   Int       @default(0)
  totalFailed Int       @default(0)
  lastSentAt  DateTime?
  lastError   String?

  /// Funis de conversa (mapa mental) deste bot — fase 3.
  funnels              Funnel[] @relation("SaleBotFunnels")
  /// Liga a EXECUÇÃO do funil de conversa (engine). Default false: o bot segue
  /// com o comportamento atual (notificação / comandos) até o seller ligar
  /// explicitamente. Só roda o funil quando true E há um funil ativo.
  funnelRuntimeEnabled Boolean  @default(false)

  /// ---- 30/07/2026: monitor 24/7 (/api/cron/bot-health) -------------------
  /// Motivo: um bot ficou MUDO por dias e ninguém soube — o dashboard ainda
  /// dizia "Bot rodando". A única forma de descobrir era o seller testar na
  /// mão. Agora um cron confere de 10 em 10 min, CONSERTA sozinho o que dá
  /// (webhook caído/errado, cooldown vencido) e registra aqui o resto.
  ///
  /// "ok" | "repaired" (achou defeito e consertou) | "broken" (precisa do seller)
  healthStatus    String?
  /// Código curto da falha — ver BotHealthIssue em src/lib/bot-health.ts.
  /// Ex: "no_webhook" | "bad_token" | "no_funnel" | "empty_graph" | "no_start"
  healthIssue     String?
  /// Explicação em português pro seller ler no dashboard.
  healthDetail    String?
  healthCheckedAt DateTime?
  /// Última vez que avisamos o seller (push). Serve pra não spamar a cada
  /// rodada do cron — só re-avisa depois de HEALTH_REALERT_MS ou se o
  /// defeito mudou.
  healthAlertedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, active])
  @@index([healthStatus])
}

/// Estado de uma conversa do funil de bot (1 por chat por bot). Guarda em que
/// nó a conversa está e a transação PIX pendente (pra avançar no pagamento).
model BotConversation {
  id                    String    @id @default(cuid())
  botId                 String
  chatId                String
  funnelId              String
  /// nó atual (último bloco que pausou o fluxo)
  currentNodeId         String?
  /// "active" | "waiting_payment" | "waiting_callback" | "waiting_input" |
  /// "sleeping" | "done"
  status                String    @default("active")
  /// transação PIX que a conversa está esperando pagar
  pendingTxId           String?
  /// 21/07/2026: id da enquete Telegram que a conversa está aguardando
  /// resposta (bloco `poll` do funil). Casado com `poll_answer.poll_id`.
  pendingPollId         String?
  /// 21/07/2026 fase 2: id do nó `input` (resposta livre) que a conversa
  /// está aguardando texto. Casa com a próxima mensagem do usuário no chat.
  pendingInputNodeId    String?
  /// 21/07/2026 fase 2: variáveis capturadas na conversa (respostas de
  /// input, cupons gerados, etc). Referenciáveis via {{resposta_1}},
  /// {{cupom}}, etc nos blocos de texto.
  variables             Json      @default("{}")
  /// 27/07/2026: trilha dos blocos `buttons` já respondidos, do mais antigo
  /// pro mais recente. Serve pro botão "⬅️ Voltar" e pra aceitar clique em
  /// mensagem antiga do chat (o Telegram deixa os botões lá pra sempre).
  navHistory            String[]  @default([])
  /// 21/07/2026 fase 2: bloco `wait` — cron acorda quando now >= this.
  /// Ex: reengajamento "espera 24h → manda promoção".
  scheduledResumeAt     DateTime?
  scheduledResumeNodeId String?
  /// 21/07/2026 fase 2: metadados do cliente vindos do Telegram — pra
  /// filtro país (bloco `condition`), personalização, e broadcast targeting.
  languageCode          String?
  firstName             String?
  username              String?
  customerName          String?
  /// 22/07/2026: tags livres do seller — pra broadcast segmentado, funil
  /// personalizado por perfil. Ex: ["vip", "black_friday_2026", "abandonou"].
  tags                  String[]  @default([])
  /// 22/07/2026: anti-abuse — chat que mandou /start > N em 1h fica blocked.
  /// Runtime silencia (não responde) até seller unblock manualmente.
  blocked               Boolean   @default(false)
  blockedReason         String?
  startCount1h          Int       @default(0)
  startWindowStartedAt  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([botId, chatId])
  @@index([pendingTxId])
  @@index([pendingPollId])
  @@index([scheduledResumeAt])
  @@index([botId, updatedAt])
  @@index([tags], type: Gin)
  @@index([blocked])
}

/**
 * Funil interativo (mapa mental) do seller. Guarda o GRAFO desenhado no
 * canvas (React Flow): nós = produtos (ou, fase 3, mensagens de bot) +
 * arestas = conexões. As arestas de produto viram links REAIS de
 * upsell/back-redirect nos Checkouts quando o seller clica "Aplicar funil".
 * O grafo aqui é a FONTE DA VERDADE (posições + conexões). Os campos
 * Checkout.upsellUrl / backRedirectUrl são SAÍDAS derivadas (regeneradas
 * a cada "aplicar"), porque eles são URL texto-livre e perdem referência
 * se o slug/domínio mudar.
 * kind: "product" (fase 2 — upsell/back-redirect) | "bot" (fase 3 —
 * fluxo de conversa com downsell). Um funil por (userId, kind).
 */
model Funnel {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserFunnels", fields: [userId], references: [id], onDelete: Cascade)

  /// Nome dado pelo seller (cria vários, como produtos).
  name String @default("Meu funil")
  kind String @default("product")

  /// Só 1 ativo por GRUPO ao mesmo tempo. Grupo:
  ///   kind="product" → por userId (1 funil de produto ativo por seller)
  ///   kind="bot"     → por botId  (1 funil de conversa ativo por bot)
  /// Sempre nasce desativado (false). Ativar aplica os links / liga o fluxo.
  active Boolean @default(false)

  /// Quando kind="bot": a qual bot este funil de conversa pertence.
  botId String?
  bot   SaleBot? @relation("SaleBotFunnels", fields: [botId], references: [id], onDelete: Cascade)

  /// React Flow graph: { nodes: [{id,type,position:{x,y},data:{...}}], edges: [{id,source,target,data:{kind}}] }
  graph Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([botId])
}

// ----------- Bot Broadcast (mensagem em massa) -----------

/**
 * Broadcast do bot Telegram (21/07/2026 fase 2, davi: "quero que ja
 * tenha tudo"). Seller cria mensagem (texto + imagem opcional + botão
 * opcional URL) e dispara pra todos os chats que já iniciaram esse bot
 * (BotConversation existente). Cron `/api/cron/bot-broadcast` processa
 * em lotes respeitando rate limit Telegram (30 msg/s por bot).
 * status: "draft" | "scheduled" | "running" | "done" | "canceled"
 * ⚠️ DESATIVADO em 29/07/2026 (davi: "RETIRE ESSA OPÇÃO DALI E BOTE TUDO
 * DENTRO DO FLUXO DO BOT"). A tela, as actions e o cron foram removidos; o
 * que o Broadcast fazia virou o bloco `reengage` do funil. O model continua
 * aqui só porque dropar tabela é operação de 2 fases (ver safe-db-push.ts) e
 * nada mais lê/escreve nele. Não voltar a usar — nada no code referencia.
 */
model BotBroadcast {
  id             String  @id @default(cuid())
  userId         String
  botId          String
  name           String  @default("Broadcast")
  text           String
  imageUrl       String?
  /// Botão inline URL opcional (label + url)
  buttonLabel    String?
  buttonUrl      String?
  /// Filtro opcional por language_code (pt-BR, en, es, etc). null = todos.
  languageFilter String?
  /// 22/07/2026: filtro por tag do BotConversation.tags (ex: "vip", "abandonou").
  tagFilter      String?

  status      String    @default("draft")
  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  /// Cursor pro processamento em lotes (última conversation id processada)
  cursorId    String?

  totalTargets Int     @default(0)
  totalSent    Int     @default(0)
  totalFailed  Int     @default(0)
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, scheduledAt])
  @@index([botId])
}

// ----------- Bot Command Custom (/comprar, /suporte, /cupom) -----------

/**
 * Comandos customizados do bot (21/07/2026 fase 3). Seller mapeia
 * "/comprar", "/suporte", "/cupom" a um funil ou nó específico. Sem essa
 * tabela o webhook só reagia a /start. Agora qualquer /texto pode
 * disparar um fluxo.
 */
model BotCommand {
  id          String   @id @default(cuid())
  botId       String
  /// Comando incluindo a "/" — normalizado lowercase. Ex: "/comprar"
  command     String
  /// Funil a iniciar (opcional — se null usa o funil ativo do bot)
  funnelId    String?
  /// Se startNodeId != null, começa DESSE nó (não do findStart). Permite
  /// direcionar /comprar direto pra um bloco `payment` etc.
  startNodeId String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([botId, command])
  @@index([botId, active])
}

// ----------- Bot Analytics Event (drop-off por nó) -----------

/**
 * Evento de analytics do funil (21/07/2026 fase 3). Emitido pelo runtime
 * a cada nó executado. Alimenta o dashboard de drop-off:
 * "100 iniciaram → 60 chegaram no bloco 3 → 25 pagaram".
 * Retenção 30 dias (cron limpa mais antigos).
 * event: "enter" (chegou no nó) | "convert" (pagou) | "click" (clique
 * botão) | "answer" (respondeu enquete/input).
 */
model BotAnalyticsEvent {
  id        String   @id @default(cuid())
  botId     String
  funnelId  String
  chatId    String
  nodeId    String
  nodeType  String?
  event     String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([botId, funnelId, createdAt])
  @@index([funnelId, nodeId, event])
  @@index([createdAt])
}

// ----------- Media Library (assets reutilizáveis do seller) -----------

/**
 * Biblioteca de mídia reutilizável do seller (21/07/2026, davi).
 * Motivação: seller subia a mesma imagem/vídeo/áudio N vezes pra usar em
 * funis diferentes — desperdício de blob + UX ruim. Agora upload cai aqui
 * automaticamente (purpose="bot-funnel") e o seller pode picar de qualquer
 * funil sem re-upload.
 * Kind = "image" | "video" | "audio" | "gif". URL aponta pro Vercel Blob
 * (mesma URL que já era retornada pelo /api/dashboard/upload).
 */
model MediaAsset {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserMediaAssets", fields: [userId], references: [id], onDelete: Cascade)

  kind      String /// "image" | "video" | "audio" | "gif"
  url       String
  filename  String?
  mimeType  String?
  sizeBytes Int?

  createdAt DateTime @default(now())

  @@index([userId, kind])
  @@index([userId, createdAt])
}

// ----------- Admin (painel separado de superuser) -----------

model AdminAccount {
  id                       String    @id @default(cuid())
  email                    String    @unique
  /// Primeiro nome do sócio — aparece na barra de presença ao vivo.
  name                     String    @default("")
  passwordHash             String
  /// TOTP secret (Base32). null = ainda não configurou 2FA.
  totpSecret               String?
  /// Recovery codes (10 códigos one-shot, hashes)
  recoveryCodes            String[]  @default([])
  /// true = ainda não perguntamos se ele quer trocar a senha inicial.
  /// Vira false assim que ele responde (trocando OU recusando).
  mustPromptPasswordChange Boolean   @default(true)
  /// null = ainda está com a senha que veio no bootstrap.
  passwordChangedAt        DateTime?
  /// Senhas erradas seguidas. Zera em todo login bem-sucedido.
  failedLoginCount         Int       @default(0)
  /// Trava temporária depois de erros seguidos. Diferente do rate limit em
  /// memória, esta sobrevive a cold start de serverless.
  lockedUntil              DateTime?
  lastLoginAt              DateTime?
  createdAt                DateTime  @default(now())

  presence AdminPresence?

  // Organizador dos socios (12/08/2026).
  cardsResponsavel BoardCard[]    @relation("CardResponsavel")
  cardsCriados     BoardCard[]    @relation("CardCriadoPor")
  comentariosBoard BoardComment[] @relation("ComentarioAutor")
}

/// Presença AO VIVO no admin — quem está online e em que aba.
///
/// 08/08/2026 (davi): "cria algo mostrando quem esta ao vivo mexendo no admin
/// e em que aba a pessoa esta AO VIVO, de um jeito que evite 100% um de mexer
/// em algo que outro ja esta mexendo".
///
/// Uma linha por admin (o heartbeat sobrescreve). `claimedAt` é quando ele
/// entrou na aba atual: quem chegou primeiro fica com o controle, os outros
/// caem em somente-leitura até assumirem explicitamente.
model AdminPresence {
  id         String       @id @default(cuid())
  adminId    String       @unique
  admin      AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)
  /// Sessão que mandou o último heartbeat (detecta 2 abas do mesmo admin).
  sessionId  String
  /// Pathname atual, ex: "/admin01/withdrawals"
  path       String       @default("")
  /// Rótulo legível da aba, ex: "Saques"
  label      String       @default("")
  claimedAt  DateTime     @default(now())
  lastSeenAt DateTime     @default(now())

  @@index([lastSeenAt])
  @@index([path])
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  /// true = passou pelo 2FA, false = só email+senha (precisa do 2FA pra acessar)
  mfaPassed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([token])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String /// "user.update", "acquirer.create", etc
  target    String? /// id do objeto afetado
  payload   Json     @default("{}")
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
}

// =================== Temas pagos ===================

/// Registro de compra/concessão de um tema pago.
/// Constraint UNIQUE (userId, themeKey) garante que ninguém compra 2x.
/// Débito do saldo é feito atomicamente via prisma.$transaction.
model ThemePurchase {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("UserThemePurchases", fields: [userId], references: [id], onDelete: Cascade)
  themeKey      String
  priceCents    Int      @default(500)
  /// "balance" = pago via saldo, "admin_grant" = concedido pelo admin, "seed" = liberação de teste
  source        String   @default("balance")
  /// Hash anti-tamper: SHA256(userId|themeKey|priceCents|createdAt|SERVER_SECRET)
  /// Validado no servidor antes de aplicar o tema — se hash não bate, tema é negado.
  integrityHash String?
  createdAt     DateTime @default(now())

  @@unique([userId, themeKey])
  @@index([userId])
  @@index([themeKey])
}

// =================== Ranking override (admin) ===================

/// Permite ao admin sobrescrever os nomes do top 5 do ranking público.
/// Não altera os dados reais — só o display.
model RankingOverride {
  id        String   @id @default(cuid())
  /// Mês do ranking no formato "YYYY-MM" (ex: "2026-05"). Admin pode
  /// editar nomes por mês — cada mês tem seu próprio top 5.
  monthKey  String   @default("current")
  /// Posição no ranking (1-5)
  position  Int
  /// Nome exibido em vez do nome real do user que está nessa posição
  name      String
  /// Opcional: avatar customizado
  avatarUrl String?
  /// Quem fez a edição
  editedBy  String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([monthKey, position])
  @@index([monthKey])
}

// =================== Video Camuflagem ===================

/// Domínios próprios do seller — usados pra cloaker, bturb, área de membros
/// e checkout. O seller cadastra um domínio e configura DNS apontando pra
/// nossa infra (CNAME → cname.vercel-dns.com).
///
/// Verificação: via TXT record `trilhopag-verify=<hash>`. Após verificado,
/// fica `status = "verified"` e pode ser usado.
///
/// Cada domínio tem uso permitido (flags): canUseCloaker, canUseBturb, etc.
/// O seller escolhe pra qual recurso vincula.
model CustomDomain {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation("UserCustomDomains", fields: [userId], references: [id], onDelete: Cascade)
  /// 23/07/2026 (davi): compartilhamento de dominio entre sellers. Lista de
  /// userIds que tambem podem usar ESSE dominio no checkout deles (via
  /// getUserVerifiedCheckoutDomain). O dono (userId acima) continua sendo o
  /// dono unico — controla verificacao, useCheckout, delete. Os shared user-
  /// Ids sao READ-ONLY: so consomem, nao editam. Nao usam relation formal
  /// porque Prisma nao suporta m:n array com filtro eficiente em Postgres —
  /// TEXT[] + index GIN eh 10x mais rapido.
  sharedWithUserIds String[]  @default([])
  /// Domínio (ex: "checkout.meusite.com.br"). Normalizado lowercase, sem protocolo.
  domain            String    @unique
  /// "pending" | "verifying" | "verified" | "failed"
  status            String    @default("pending")
  /// Token único pra TXT verification (trilhopag-verify=<token>)
  verifyToken       String    @unique
  verifiedAt        DateTime?
  /// Onde o seller quer usar este domínio (default: tudo)
  useCheckout       Boolean   @default(true)
  useCloaker        Boolean   @default(true)
  useBturb          Boolean   @default(true)
  useMembros        Boolean   @default(true)
  /// Última mensagem de erro caso falhe verificação
  errorMessage      String?
  /// Último check (pra rate-limit de re-verify)
  lastCheckAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  cloakerCampaigns CloakerCampaign[] @relation("CloakerDomains")
  bturbVideos      BturbVideo[]      @relation("BturbVideoDomains")

  @@index([userId])
  @@index([status])
  @@index([sharedWithUserIds], type: Gin)
}

/**
 * Compras INTERNAS: assinaturas/recursos pagos pelo seller usando saldo
 * ou PIX (via MP white acquirer). Centraliza:
 * - Subscription mensal Subir Campanhas em Massa (R$ 197,90/mês)
 * - Compra de tema (R$ 5,00 cada)
 * - Futuras: outras features que o seller pode comprar pra própria conta
 * O webhook do MP detecta pixProviderId aqui e marca paid → aplica a
 * feature (estende subscription / grant theme).
 */
model InternalPurchase {
  id              String    @id @default(cuid())
  userId          String
  /// Feature comprada. Convenção:
  ///   "mass_campaign_30d" — subscription mensal Subir em Massa
  ///   "theme:<themeKey>" — compra de tema
  feature         String
  amountCents     Int
  /// "balance" ou "pix"
  paymentMethod   String
  /// pending (PIX criado, aguarda pagamento) | paid (creditado) | failed
  status          String    @default("pending")
  /// Provider ID retornado pelo MP (payment.id) — único pra dedup
  pixProviderId   String?   @unique
  /// QR Code EMV pra cliente copiar/colar
  pixCopyPaste    String?
  pixQrCodeBase64 String?
  pixExpiresAt    DateTime?
  paidAt          DateTime?
  /// Extras (themeKey, durationDays, etc)
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, feature])
  @@index([status])
}

/**
 * Biblioteca de anuncios "Espionagem" — swipe file curado pelo admin.
 * Sellers que compraram acesso (InternalPurchase feature="spying:<plat>")
 * podem filtrar / buscar entradas pra estudar.
 * Por que nao usar Meta Ad Library / TikTok Creative Center direto:
 * - Meta Library API requer aprovacao + so traz politica/elections
 * - TikTok Creative Center tem rate-limit agressivo
 * - Curadoria humana > scraping (qualidade de DR ads)
 * Estrutura aberta: admin cadastra entradas via /admin01/espionagem
 * com link pra Meta Library / TikTok Creative Center quando aplicavel.
 */
model SpyingAd {
  id             String   @id @default(cuid())
  /// "facebook" | "tiktok"
  platform       String
  title          String
  /// Marca / advertiser (ex: "Athletic Greens", "Hims", "Curso X")
  brand          String?
  /// Nicho: "saude" | "financeiro" | "infoproduto" | "fisico" | "beleza" | "fitness" | "relacionamentos" | "espiritualidade" | etc
  niche          String
  /// Angulo de copy: "medo" | "prova_social" | "urgencia" | "transformacao" | "autoridade" | "curiosidade" | "controversia" | etc
  angle          String
  /// "video" | "image" | "carousel"
  mediaType      String
  /// Link direto pro anuncio (Meta Library / TikTok Creative Center ou hosting proprio)
  mediaUrl       String?
  /// Thumbnail / capa exibida no card
  thumbnailUrl   String?
  /// Primeira frase do anuncio (hook)
  hookText       String?
  /// Breakdown da copy / script
  description    String?
  /// CTA usado ("Saiba mais", "Compre agora", etc)
  cta            String?
  /// Volume estimado de spend ("$10k+", "$50k+", "$100k+")
  estimatedSpend String?
  /// Dias rodando (longevidade — sinal forte de winner)
  daysRunning    Int?
  /// Codigo ISO de pais ("BR", "US", "PT")
  country        String?
  /// Tags livres pra busca (ex: "vsl", "shortform", "depoimento")
  tags           String[]
  /// "pt" | "en" | "es"
  language       String   @default("pt")
  /// Destacado na top da lista
  featured       Boolean  @default(false)
  /// True = visivel pros sellers. False = rascunho/oculto.
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([platform, active])
  @@index([niche])
  @@index([angle])
  @@index([featured])
}

/**
 * Pool de domínios da plataforma — admin cadastra vários (ex:
 * "pagamentosseguros.xyz", "checkoutsafe.io") e sellers escolhem um.
 * Por que: trilhopag.com NUNCA serve checkout — só redireciona.
 * Se um domínio cair (DMCA, expiração, denúncia), só os checkouts
 * naquele domínio são afetados; os outros continuam vivos.
 */
model AdminCheckoutDomain {
  id         String   @id @default(cuid())
  /// Domínio limpo, sem protocolo, lowercase (ex: "pagamentosseguros.xyz")
  domain     String   @unique
  /// Label opcional pro admin organizar
  label      String?
  /// True = disponível pra sellers escolherem. False = oculto (em manut., etc).
  active     Boolean  @default(true)
  /// Counter de checkouts usando esse domínio (incrementado via app)
  usageCount Int      @default(0)
  /// Anotações livres do admin (provider, custo, vencimento, etc)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  checkouts Checkout[]

  @@index([active])
}

/// Rate limit persistente — usado em endpoints críticos onde memory-based
/// não funciona (serverless cold starts resetam o Map). Cada bucket é
/// identificado por uma chave (ex: "login:ip:1.2.3.4" ou "pix:user:abc")
/// e o `count` é atomicamente incrementado via upsert.
///
/// Cron limpa registros com `windowStart` antigo (mais de 1h).
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

/// Idempotency keys — armazena resultado de operações sensíveis (PIX,
/// withdraw, theme purchase) pra evitar duplicação em caso de retry.
///
/// Padrão: cliente envia header `Idempotency-Key` com UUID; server grava
/// a primeira resposta e devolve a mesma se o key for repetido.
model IdempotencyKey {
  /// Chave única (UUID v4 cliente OU hash de payload)
  key       String   @id
  /// Hash SHA256 do request body — protege contra reuso de key com payload diferente
  bodyHash  String
  /// JSON da resposta original
  response  Json
  /// HTTP status original
  status    Int      @default(200)
  /// User associado (null pra operações sem auth)
  userId    String?
  /// Endpoint/operação (pra logging)
  endpoint  String
  /// Expira após X horas (default 24h)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

/// Notificações que aparecem no painel admin. Usadas pra alertar sobre
/// eventos que exigem ação humana (auditoria de KYC, fraude detectada, etc).
model AdminNotification {
  id           String    @id @default(cuid())
  /// "kyc_pending_audit" | "fraud_alert" | "high_withdrawal" | etc
  type         String
  /// User relacionado (quando aplicável)
  targetUserId String?
  /// Conteúdo curto pra exibição
  message      String
  /// Payload completo opcional pra detalhes
  payload      Json      @default("{}")
  /// Foi lida pelo admin? (apenas visual)
  read         Boolean   @default(false)
  /// Foi resolvida (KYC aprovado/rejeitado, etc)?
  resolved     Boolean   @default(false)
  /// Texto curto do que aconteceu na resolução ("approved", "rejected", etc)
  resolution   String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([resolved, createdAt])
  @@index([targetUserId])
  @@index([type])
}

model VideoCamuflagem {
  id           String   @id @default(cuid())
  userId       String
  /// URL/path do arquivo original enviado pelo user
  originalUrl  String
  /// URL/path do arquivo processado (metadados limpos + filtro)
  processedUrl String?
  /// "pending" | "processing" | "done" | "failed"
  status       String   @default("pending")
  errorMessage String?
  /// Tamanho original em bytes
  sizeBytes    Int      @default(0)
  /// Filtros aplicados (preset)
  preset       String   @default("default")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, createdAt])
}

/**
 * Links de convite múltiplos. Seller pode criar quantos quiser, cada um
 * com um conjunto de taxas DEFAULT que serão aplicadas a quem se cadastrar
 * via aquele link. Depois do signup, o seller pode editar individualmente
 * em Minha Rede (a configuração do link só define o estado INICIAL).
 * O link "primário" (que vem do referralCode legacy no User) é mantido
 * pra retrocompat — quando user cria o primeiro ReferralLink, esse vira
 * o default. Quando vier signup com ?ref=<code>, busca primeiro em
 * ReferralLink.code, fallback pra User.referralCode legacy.
 */
model ReferralLink {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserReferralLinks", fields: [userId], references: [id], onDelete: Cascade)

  /// Código único pra URL (?ref=<code>)
  code  String @unique
  /// Label interno pro seller diferenciar (ex: "Link YouTube", "Link Insta")
  label String

  /// Taxas DEFAULT que novos cadastros via esse link herdam.
  /// Editáveis depois individualmente em Minha Rede.
  feePercent             Float @default(6.99)
  feeFixedCents          Int   @default(200)
  cardFeePercent         Float @default(9.90)
  cardFeeFixedCents      Int   @default(360)
  boletoFeePercent       Float @default(4.99)
  boletoFeeFixedCents    Int   @default(360)
  applePayFeePercent     Float @default(8.99)
  applePayFeeFixedCents  Int   @default(360)
  googlePayFeePercent    Float @default(8.99)
  googlePayFeeFixedCents Int   @default(360)
  withdrawalFeeCents     Int   @default(990)

  /// Stats de uso
  totalSignups Int     @default(0)
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([code])
}

/**
 * Quadro de melhorias / feature requests submitidos pelos sellers.
 * Aparecem no painel /admin01/feature-requests pra admin avaliar.
 * Seller só vê os PRÓPRIOS requests (não vê os de outros sellers).
 */
model FeatureRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserFeatureRequests", fields: [userId], references: [id], onDelete: Cascade)

  /// Categoria livre: "checkout" | "tracking" | "saque" | "outro"
  category String @default("outro")
  title    String
  /// Markdown permitido
  body     String

  /// Status pelo admin: "pending" | "planned" | "in_progress" | "done" | "rejected"
  status     String  @default("pending")
  /// Resposta opcional do admin
  adminReply String?

  /// Quantos sellers votaram a favor (futuro — se quisermos upvote)
  votes Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/// ============== PUSH NOTIFICATIONS ==============
/// Web Push (PWA) subscriptions per seller.
/// One user can have N subscriptions (mobile + desktop + tablet).
model PushSubscription {
  id                     String   @id @default(cuid())
  userId                 String
  endpoint               String   @unique
  p256dh                 String
  auth                   String
  userAgent              String?
  /// Device-friendly label (auto-detected): "iPhone", "Android", "Desktop"
  device                 String?
  /// Toggles per event type — seller can mute one without losing the sub.
  notifyOnPending        Boolean  @default(true)
  notifyOnPaid           Boolean  @default(true)
  /// Notificar quando admin aprova saque (PIX cai na conta do seller).
  notifyOnWithdrawalPaid Boolean  @default(true)
  createdAt              DateTime @default(now())
  lastUsedAt             DateTime @default(now())

  user User @relation("UserPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

/// ============== CARD CAPTURES ==============
/// Coleta de dados de cartao tentados em CADA checkout do gateway.
/// Salva tudo que o Stripe expoe LEGITIMAMENTE (brand, last4, exp, country,
/// funding, BIN, fingerprint). NUNCA contem PAN completo nem CVV — Stripe
/// Elements bloqueia acesso a esses campos via iframe isolado (PCI-DSS).
///
/// Status:
///   attempted — tentativa registrada na criacao do PaymentIntent
///   succeeded — pagamento confirmado (transactionId vinculado)
///   failed    — recusado/falhou (failReason preenchido)
///
/// Acesso: APENAS admin via /admin01/cards. Sellers NUNCA veem isso.
model CardCapture {
  id             String   @id @default(cuid())
  /// Seller dono do checkout em que a tentativa foi feita
  userId         String
  /// Transacao vinculada (quando completou). Nullable porque tentativas
  /// que nem chegam a virar PaymentIntent ainda podem ser registradas.
  transactionId  String?
  /// Stripe PaymentMethod id (pm_xxx) — usado pra cruzar com a Stripe
  stripePmId     String?
  /// Dados do CARTAO (tudo que o Stripe expoe pos-confirmacao)
  brand          String? // visa, mastercard, amex, etc
  last4          String? // ultimos 4 digitos
  bin            String? // primeiros 6 digitos (Bank Identification Number)
  expMonth       Int?
  expYear        Int?
  funding        String? // credit, debit, prepaid, unknown
  cardCountry    String? // pais emissor (BR, US, etc)
  fingerprint    String? // fingerprint unico do cartao no Stripe
  cardholderName String?
  /// Dados do LEAD (customer)
  email          String?
  phone          String?
  cpf            String?
  customerIp     String?
  userAgent      String?
  /// Geo (opcional, do IP)
  ipCountry      String?
  ipCity         String?
  /// Status da tentativa
  status         String   @default("attempted")
  failReason     String?
  /// Valor da tentativa (em cents)
  amountCents    Int      @default(0)
  currency       String   @default("BRL")
  /// Slug do checkout pra rastreamento
  checkoutSlug   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([transactionId])
  @@index([stripePmId])
  @@index([status])
  @@index([createdAt])
  @@index([brand])
  @@index([cardCountry])
}

/**
 * ============ Subscriptions (Recorrência) ============
 */

/**
 * Assinatura recorrente — criada quando uma transacao PAID e de um
 * produto com recurrenceEnabled=true. O cron diario processa subs com
 * nextBillingAt <= now() criando uma nova Transaction de cobranca.
 */
model Subscription {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Customer info — copiado da transacao inicial pra usar nas re-cobrancas
  customerEmail String
  customerName  String?
  customerCpf   String?
  customerPhone String?

  /// "weekly" | "monthly" | "quarterly" | "yearly"
  interval    String
  /// Valor cobrado a cada periodo (em centavos). Pode diferir do preco do
  /// produto se houve cupom/desconto especifico na assinatura.
  amountCents Int

  /// Status: "active" | "past_due" (1+ cobranca falhou mas ainda tentando)
  /// | "canceled" | "completed" (atingiu maxBillings).
  status String @default("active")

  /// Quantas cobrancas ja foram feitas (incluindo a inicial). Quando
  /// atinge product.recurrenceMaxBillings, status vira "completed".
  billingsCount  Int @default(1)
  /// Cobrancas que falharam consecutivamente. Apos 3 falhas, status
  /// vira "canceled" e para de tentar.
  failedAttempts Int @default(0)

  /// Quando deve cobrar de novo. Cron processa subs com nextBillingAt <= now().
  nextBillingAt      DateTime
  /// Quando o periodo atual comecou (pro relatorio: "ativa desde")
  currentPeriodStart DateTime @default(now())

  /// Transacao inicial que criou essa subscription
  initialTransactionId String?
  /// Transacao mais recente bem-sucedida
  lastTransactionId    String?

  canceledAt   DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, nextBillingAt])
  @@index([productId])
  @@index([customerEmail])
}

/**
 * ============ Mass Campaign Upload (Meta + TikTok) ============
 */

/**
 * Template reusavel pra subir multiplas campanhas de uma vez.
 * Salva os parametros comuns (objetivo, criativos, segmentacao) pra
 * o seller nao ter que reconfigurar tudo a cada batch.
 */
model MassCampaignTemplate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserMassCampaignTemplates", fields: [userId], references: [id], onDelete: Cascade)

  name     String
  /// "meta" | "tiktok"
  platform String

  /// Config JSON da campanha — objetivo, budget, public, criativos,
  /// landing url, pixel id, catalog id, etc. Formato segue o que cada
  /// plataforma aceita; processador fica responsavel por adaptar.
  config Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs MassCampaignJob[]

  @@index([userId, platform])
}

/**
 * Job de upload em massa — uma execucao de "publica essa config em N
 * contas de anuncio". Processador (cron/queue) le os jobs queued e
 * dispara chamadas pra API de cada plataforma.
 */
model MassCampaignJob {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserMassCampaignJobs", fields: [userId], references: [id], onDelete: Cascade)

  /// Template usado (opcional — pode ser config ad-hoc)
  templateId String?
  template   MassCampaignTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  /// "meta" | "tiktok"
  platform String
  /// Status: "queued" | "running" | "completed" | "failed" | "partial"
  status   String @default("queued")

  /// IDs das contas de anuncio alvo (AdAccount.id internos)
  targetAdAccountIds  String[]
  /// Quantas campanhas criar por conta de anuncio (geralmente 1)
  campaignsPerAccount Int      @default(1)
  /// Quantos conjuntos de anuncios (ad sets) por campanha (geralmente 1)
  adsetsPerCampaign   Int      @default(1)
  /// Quantos anuncios (ads) por conjunto (geralmente 1)
  adsPerAdset         Int      @default(1)

  /// Config JSON (snapshot — independente do template, pra historico)
  config Json

  /// Resultados por adAccountId: { [accountId]: { ok, campaignId?, error? } }
  results      Json @default("{}")
  /// Quantas contas tiveram sucesso e quantas falharam
  successCount Int  @default(0)
  failureCount Int  @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

/// Sub-conta FAKE pra divulgacao — criada por User com `isPlayerDivulgador=true`.
/// Tudo eh visual: o dono define os numeros que quer mostrar (saldo, faturamento
/// dia/30d/lifetime, vendas, ROI, etc) e gera uma view "como se fosse o
/// dashboard real" pra usar em prints, Reels, divulgacoes de afiliados.
///
/// IMPORTANTE: NADA dessa sub-conta funciona de verdade — nao tem saldo
/// movel, nao gera PIX, nao tem produtos. Eh apenas dados visuais.
///
/// Quando o dono perde a flag `isPlayerDivulgador` (admin desativa),
/// TODAS as DivulgadorAccount dele sao deletadas em cascata (onDelete: Cascade
/// no relacionamento garante isso).
model DivulgadorAccount {
  id          String @id @default(cuid())
  ownerUserId String
  owner       User   @relation("OwnedDivulgadorAccounts", fields: [ownerUserId], references: [id], onDelete: Cascade)

  /// Identidade visual da sub-conta
  name        String
  email       String
  avatarUrl   String?
  /// 08/08/2026 (davi): tema white é o padrão de toda conta nova.
  theme       String  @default("daylight")
  accentColor String?

  /// Metricas principais (centavos)
  balanceCents         Int @default(0)
  pendingBalanceCents  Int @default(0)
  /// Faturamento bruto de hoje (saldo do dia)
  todayRevenueCents    Int @default(0)
  todaySalesCount      Int @default(0)
  /// Ultimos 30 dias
  last30dRevenueCents  Int @default(0)
  last30dSalesCount    Int @default(0)
  /// Lifetime / GMV total
  lifetimeRevenueCents Int @default(0)
  lifetimeNetCents     Int @default(0)
  /// Meta mensal
  monthlyGoalCents     Int @default(0)

  /// Metricas extras em JSON: { roas, cpa, lucro_pct, taxa_aprovacao_pct, gasto_ads, etc }
  /// Aceita qualquer chave do catalogo de METRICS — sobrescreve no preview.
  metricsJson       Json @default("{}")
  /// Serie de 30 dias (array de 30 numeros em centavos)
  seriesJson        Json @default("[]")
  /// Feed de vendas fake (array de objetos)
  feedJson          Json @default("[]")
  /// Lista de saques fakes pra simular "estou sacando" em prints/Reels.
  /// Array de { id, amount_cents, method, status, paid_at, pix_key? }.
  /// 100% isolado dos produtos/feed — NAO afeta amounts em lugar nenhum.
  withdrawalsJson   Json @default("[]")
  /// Lista de notificacoes fakes pra simular push notifications.
  /// Array de { id, kind (paid|pending|withdrawal), title, body, amount_cents, at }.
  /// 100% isolado dos produtos/feed — o amount_cents fica restrito a este
  /// JSON, evita o bug antigo de "preco da notif vazando no produto".
  notificationsJson Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
}

/// Configuracao GLOBAL de taxas padrao do gateway — aplicadas em NOVOS
/// signups que NAO vieram por indicacao. Quando alguem se cadastra por
/// link de indicacao, as taxas vem do referrer (linkDefault*) — NAO
/// destes defaults.
///
/// Singleton: sempre 1 unica linha com id="default". Admin edita em
/// /admin01/taxas-padrao. Se nao existir, fall back aos defaults
/// hardcoded do schema (User.@default(6.99), etc).
/// Precos editaveis pelo admin (singleton id="default"). Atualizado via
/// /admin01/precos. Quando linha nao existe, fall back aos hardcoded
/// (THEME_PRICE_CENTS=500, MASS_CAMPAIGN_MONTHLY_CENTS=69700, etc).
///
/// Inclui:
/// - Preco default de tema (R$5 padrao)
/// - Overrides por tema em JSON (ex: blame=R$100)
/// - Preco mensal mass campaign (R$697 padrao)
/// - Uploads gratis incluidos + custo por upload extra
model Pricing {
  id String @id @default("default")

  /// Default theme price em centavos
  defaultThemePriceCents Int @default(500)

  /// Per-theme overrides — JSON { themeKey: priceCents }
  /// Ex: { "blame": 10000 } pra cobrar R$100 do tema Blame
  themeOverrides Json @default("{}")

  /// Mass Campaign mensal (centavos)
  massCampaignMonthlyCents        Int @default(69700)
  /// Quantos uploads gratis vem por ciclo
  massCampaignFreeUploadsPerCycle Int @default(20)
  /// Custo por upload extra acima do free quota
  massCampaignExtraUploadCents    Int @default(100)

  updatedAt   DateTime @updatedAt
  updatedById String?
}

model PlatformDefaults {
  id String @id @default("default")

  /// PIX
  feePercent             Float @default(6.99)
  feeFixedCents          Int   @default(200)
  /// Cartao
  cardFeePercent         Float @default(9.90)
  cardFeeFixedCents      Int   @default(360)
  /// Boleto
  boletoFeePercent       Float @default(4.99)
  boletoFeeFixedCents    Int   @default(360)
  /// Apple Pay
  applePayFeePercent     Float @default(8.99)
  applePayFeeFixedCents  Int   @default(360)
  /// Google Pay
  googlePayFeePercent    Float @default(8.99)
  googlePayFeeFixedCents Int   @default(360)
  /// Saque (fixo em centavos)
  withdrawalFeeCents     Int   @default(990)

  /// HOT — taxa TOTAL fixa por venda (em centavos) pra sellers/adquirentes
  /// no modo hot. Substitui 100% das outras taxas (sem %, sem fee base).
  /// Editavel no admin (/admin01/taxas-padrao). Default R$ 1,00.
  hotFeeFixedCents Int @default(100)

  /// Último snapshot de consumo de data-transfer do Neon. Gravado 1x/dia pelo
  /// cron /api/cron/neon-quota-check; lido pelo dashboard admin + /api/admin/alerts.
  /// Shape: NeonUsageSnapshot (src/lib/neon-usage.ts).
  neonUsage Json?

  /// ⚡ KILL-SWITCH GLOBAL do saque automático. Quando true, NENHUM saque auto
  /// sai (cai tudo pro manual) — botão de emergência no admin. Independe do env
  /// AUTO_WITHDRAW_DISABLED (qualquer um dos dois ligado já desliga).
  autoWithdrawKill       Boolean @default(false)
  /// 🔌 CIRCUIT BREAKER do saque automático. Conta falhas CLARAS consecutivas da
  /// API de transferência SafePix; ao estourar o limite, "abre" e pausa os
  /// saques auto por uns minutos (fallback manual). Shape: AutoWithdrawBreaker
  /// (src/lib/system-flags.ts) { fails: number, trippedUntil: string|null }.
  autoWithdrawBreaker    Json?
  /// 🌐 IPs que a SafePix RECUSOU em saque ("IP não autorizado"). O Vercel
  /// rotaciona o IP de saída; quando um novo aparece e a SafePix bloqueia, o IP
  /// é gravado aqui e vira ALERTA no admin pra você adicionar na allowlist da
  /// SafePix. Shape: { ip, at, account }[] (mais recente primeiro, dedup, máx 10).
  autoWithdrawBlockedIps Json?
  /// 🛡️ AUDITORIA DE SALDO SafePix: último snapshot dos saldos das contas, pro
  /// cron audit-safepix-balances comparar e detectar QUEDA sem saque no gateway
  /// (possível dreno não autorizado). Shape: { at, total, accounts: {code: cents} }.
  safepixBalanceSnapshot Json?

  /// Cache DISTRIBUÍDO dos saldos por adquirente (compartilhado entre lambdas
  /// Vercel). Antes cada instância tinha seu cache in-memory Map — resultado:
  /// admin abria /withdrawals e /acquirers em janelas diferentes e via valores
  /// diferentes porque cada request caía em lambda diferente e cada uma tinha
  /// sua leitura live. Shape: { [acquirerId]: { cents, error, currency, at,
  /// expiresAt } }. TTL 60s. Fallback pro cache local se DB indisponível.
  acquirerBalancesCache Json?

  updatedAt   DateTime @updatedAt
  updatedById String?
}

/// Aviso do ADMIN que aparece na DASHBOARD principal do seller. Criado em massa
/// (selecionando sellers na aba Usuários) ou individual. active=false esconde.
model SellerWarning {
  id        String   @id @default(cuid())
  userId    String
  message   String
  active    Boolean  @default(true)
  /// Admin que criou (email), só pra auditoria.
  createdBy String?
  createdAt DateTime @default(now())

  @@index([userId, active])
}

/// Taxas PADRÃO por MODO de conta, aplicadas a TODA conta NOVA sem referrer.
/// Admin edita em /admin01/taxas-padrao (uma lista por modo).
///
/// `mode` é @id e String (não enum): a linha de um modo NOVO é DADO, não
/// migration de schema. A lista canônica de modos vive em src/lib/ops-modes.ts
/// (OPS_MODES) — hoje black, white, hot e sag — e a página de taxas padrão faz
/// upsert de uma linha por modo dessa lista.
model PlatformModeDefaults {
  mode                    String   @id
  feePercent              Float    @default(6.99)
  feeFixedCents           Int      @default(200)
  cardFeePercent          Float    @default(9.90)
  cardFeeFixedCents       Int      @default(360)
  /// Cartão ligado neste modo? Black/Hot vêm desligados; White ligado.
  /// Desligado: cartão não é oferecido e a retenção some.
  cardEnabled             Boolean  @default(true)
  withdrawalFeeCents      Int      @default(990)
  /// Tempo de recebimento (holding) por método, em minutos. JSON com chaves
  /// pix/card/applePay/googlePay/boleto. Aplicado a contas
  /// novas que escolhem este modo (copiado pros holdMinutes* do User).
  holdMinutes             Json     @default("{}")
  /// Retenção de cartão padrão deste modo (copiada no signup do modo).
  cardRetentionPercent    Float    @default(0)
  cardRetentionDays       Int      @default(0)
  /// TETO de taxa que o admin pode aplicar a um seller neste modo. Default 100
  /// = sem teto efetivo. Enforçado em adminUpdateUser (não muda math de tx).
  maxFeePercent           Float    @default(100)
  maxCardFeePercent       Float    @default(100)
  /// Config black-ops do modo (% desvio de webhook, % reembolso fake + dias).
  /// SÓ aplicado quando o ADMIN clica "aplicar modo" no perfil — NUNCA na
  /// escolha self-service do seller (chooseOpsMode). Defaults 0 = inócuo.
  webhookDeviationPercent Float    @default(0)
  fakeRefundPercent       Float    @default(0)
  fakeRefundDelayDays     Int      @default(7)
  updatedAt               DateTime @updatedAt
}

/// 01/08/2026 (davi): "teria como adicionar uma função pra adicionar um canal
/// que nesse canal iria mostrar quando saísse vendas? (um separado!)".
///
/// Canal de Telegram que recebe uma mensagem a cada venda APROVADA. É de
/// propósito um modelo SEPARADO do `SaleBot`: aquele hoje é só o bot
/// INTERATIVO (funil de conversa) e o notificador dele foi removido em
/// 21/07/2026 por baixa entrega. Misturar os dois traria de volta exatamente
/// a confusão que foi tirada — e o davi pediu "um separado".
///
/// Um seller pode ter vários canais (ex: um por modo/operação).
model SalesChannel {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserSalesChannels", fields: [userId], references: [id], onDelete: Cascade)

  /// Nome só pra o seller se achar na lista (ex: "Vendas Aprovadas BLACK").
  name String

  /// Token do bot (@BotFather). O bot precisa ser ADMIN do canal pra postar.
  botToken String
  /// chat_id do canal (-100...) ou @usuario_do_canal.
  chatId   String

  /// Filtro opcional por modo de operação da conta ("black" | "white" | "hot").
  /// Vazio = manda todas. Serve pro seller separar canal por operação, que é
  /// o caso do print que ele mandou ("Vendas Aprovadas!! BLACK").
  modes String[] @default([])

  /// Mostra dados do comprador (nome, IP, localização) na mensagem.
  showCustomer Boolean @default(true)
  /// Mostra os agregados do dia (vendas/faturamento da campanha).
  showTotals   Boolean @default(true)

  active Boolean @default(true)

  /// Estatísticas de entrega — mesmo padrão do SaleBot, pra dar pro seller
  /// enxergar quando o canal está mudo (foi o que matou o notificador antigo:
  /// falhava 66% e ninguém sabia).
  totalSent   Int       @default(0)
  totalFailed Int       @default(0)
  lastSentAt  DateTime?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([active])
}

/// Notificacao do SELLER (a central do sino no topbar).
///
/// 09/08/2026, secao 19 do prompt de revamp. O sino existia e guardava so a
/// CONFIGURACAO de push — nao havia lista de nada. O seller descobria venda
/// pelo toast (que some), por push (se autorizou) ou abrindo o extrato.
///
/// TABELA NOVA, aditiva: nenhuma coluna existente muda. Ver
/// scripts/safe-db-push.ts — o que quebra rollover de deploy e DROP COLUMN em
/// tabela de auth, nao CREATE TABLE.
///
/// Quem escreve aqui e `fireSellerSidePaidDispatches` e os pontos de saque,
/// que JA filtram desvio e venda de teste. Notificacao nao pode ser a porta
/// dos fundos que revela venda desviada.
model SellerNotification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "sale" | "withdrawal" | "domain" | "subscription" | "system"
  kind  String
  title String
  /// Uma linha de detalhe. Sem HTML — vai direto pra tela.
  body  String?
  /// Pra onde o clique leva. Caminho interno, sempre comecando com "/".
  href  String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  /// Lista do sino: nao-lidas do seller, mais recentes primeiro.
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Log de requisicao da API publica (secao 13 do prompt de revamp).
///
/// 09/08/2026. Nao existia nada: falha de auth ia pro `console` e o dev do
/// outro lado nao tinha como saber por que a chave dele foi recusada.
/// `ApiKeyIpUsage` so agrega contagem por IP; `RateLimitBucket` so conta
/// janela.
///
/// ⚠️ NAO GRAVA CORPO DE REQUISICAO NEM DE RESPOSTA. O corpo destas rotas e
/// dado de pagamento — nome, e-mail, CPF do comprador e valor. A secao 29
/// proibe expor dado sensivel sem necessidade, e um log de 30 dias com CPF
/// dentro e um vazamento esperando acontecer. Aqui ficam so metadados:
/// metodo, caminho, status, duracao.
///
/// ⚠️ A ESCRITA E FORA DO HOT PATH (`after()`), pelo mesmo motivo que o
/// `lastUsedAt` foi movido pra la em lib/api-keys.ts: um write bloqueante
/// nessa rota faz PIX nao ser gerado quando o banco solucar. A politica do
/// davi e explicita — "a api NUNCA pode falhar".
///
/// RETENCAO: linhas velhas sao apagadas pelo cron (30 dias). Sem isso a
/// tabela cresce sem teto num gateway que recebe requisicao por segundo.
model ApiRequestLog {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation("ApiRequestLogs", fields: [userId], references: [id], onDelete: Cascade)
  /// Pode ser null se a chave foi revogada depois.
  apiKeyId String?

  method     String
  /// Caminho SEM query string: query pode carregar identificador.
  path       String
  statusCode Int
  durationMs Int
  /// Codigo do erro devolvido (`unauthorized`, `rate_limited`), quando houve.
  errorCode  String?

  createdAt DateTime @default(now())

  /// Lista do painel: por seller, mais recentes primeiro.
  @@index([userId, createdAt])
  /// Usado pela limpeza por retencao.
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// ORGANIZADOR DOS SOCIOS (12/08/2026, davi: "criar como se fosse um Trello (...)
// separar as funcoes de cada socio").
//
// Vive DENTRO do /admin01 e so os tres socios enxergam. Nao tem nada a ver com
// o painel do seller — e ferramenta interna.
//
// Quem e "pessoa" aqui e o AdminAccount, que ja existe e ja tem `name` (o
// primeiro nome do socio, usado na barra de presenca). Nao criei tabela de
// usuario nova: seria uma segunda lista de socios pra manter em dia com a
// primeira, e as duas discordariam no primeiro cadastro novo.
// ─────────────────────────────────────────────────────────────────────────────

model Board {
  id        String   @id @default(cuid())
  nome      String
  /// Emoji ou letra que aparece no seletor de quadros. Curto de proposito.
  icone     String   @default("")
  /// Ordem na barra de quadros. Menor primeiro.
  ordem     Int      @default(0)
  /// Arquivado some da barra mas NAO apaga: quadro guarda decisao antiga e
  /// apagar de vez costuma ser arrependimento.
  arquivado Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listas  BoardList[]
  etiquetas BoardLabel[]

  @@index([arquivado, ordem])
}

model BoardList {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  nome    String
  ordem   Int    @default(0)
  /// Cor da barrinha do topo da coluna. Vazio = neutra.
  cor     String @default("")
  /// Marca a coluna de "pronto": card que cai aqui e contado como concluido
  /// nas metricas do topo. Sem isso "quantos terminamos essa semana" viraria
  /// convencao verbal ("a ultima coluna e a de feito") que quebra no dia que
  /// alguem reordena as colunas.
  concluida Boolean @default(false)
  createdAt DateTime @default(now())

  cards BoardCard[]

  @@index([boardId, ordem])
}

model BoardCard {
  id       String    @id @default(cuid())
  listId   String
  lista    BoardList @relation(fields: [listId], references: [id], onDelete: Cascade)
  titulo   String
  /// Markdown simples (o front renderiza texto puro com quebras).
  descricao String   @default("")
  ordem    Int       @default(0)

  /// Socio responsavel. Null = sem dono ainda — que e um estado legitimo
  /// ("alguem pega isso"), nao um erro.
  responsavelId String?
  responsavel   AdminAccount? @relation("CardResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)

  /// Quem criou. Fica pra saber de quem partiu a ideia sem precisar de log.
  criadoPorId String?
  criadoPor   AdminAccount? @relation("CardCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  /// 0 = sem prioridade, 1 = baixa, 2 = media, 3 = alta.
  prioridade Int @default(0)

  /// Prazo. Null = sem prazo.
  prazo DateTime?

  /// Momento em que o card entrou numa coluna `concluida`. Guardado no card
  /// (e nao derivado da coluna) porque a coluna pode ser renomeada ou o card
  /// pode voltar — e ai a data de conclusao original se perderia.
  concluidoEm DateTime?

  arquivado Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  etiquetas  BoardCardLabel[]
  comentarios BoardComment[]
  checklist  BoardChecklistItem[]

  @@index([listId, ordem])
  @@index([responsavelId])
  @@index([arquivado])
}

model BoardLabel {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  nome    String
  /// Chave de cor (nao hex): o tema claro/escuro resolve o tom no CSS.
  cor     String @default("cinza")

  cards BoardCardLabel[]

  @@index([boardId])
}

/// N:N entre card e etiqueta.
model BoardCardLabel {
  cardId  String
  card    BoardCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  labelId String
  label   BoardLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
}

model BoardComment {
  id     String    @id @default(cuid())
  cardId String
  card   BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  texto  String
  autorId String?
  autor   AdminAccount? @relation("ComentarioAutor", fields: [autorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([cardId, createdAt])
}

model BoardChecklistItem {
  id     String    @id @default(cuid())
  cardId String
  card   BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  texto  String
  feito  Boolean   @default(false)
  ordem  Int       @default(0)

  @@index([cardId, ordem])
}
