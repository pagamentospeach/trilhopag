  parent       User      @relation("TeamMembers", fields: [parentUserId], references: [id], onDelete: Cascade)
  email        String
  name         String?
  role         String    @default("editor")
  status       String    @default("pending")
  invitedAt    DateTime  @default(now())
  joinedAt     DateTime?

  @@unique([parentUserId, email])
  @@index([parentUserId])
}

model Session {
