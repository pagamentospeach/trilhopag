  monthlyGoalCents Int     @default(0)
  soundEnabled     Boolean @default(true)
  privacyMode      Boolean @default(false)
  sidebarCollapsed Boolean @default(false)
  /// Layout customizado da dashboard (lista de widgets + tamanhos)
